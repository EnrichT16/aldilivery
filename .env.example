# Environment example
#
# Copy this file to .env and fill in real values. NEVER commit .env.
# Every value below is a placeholder. No real secret belongs in this repository.
#
# Rule Eight: The service shares no code, database, login or payment account with any
# other product. The database, the Stripe account and the SMS sender below must all be
# dedicated to the service and used by nothing else.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# The address and port the API binds. PORT is what a hosting platform sets, so the API
# reads PORT first and falls back to 8080 — the same number in development and in
# production, so there is only ever one to remember.
HOST=0.0.0.0
PORT=8080
# The browser origins allowed to call the API. One origin, or several separated by commas.
# In production this is the app's own https addresses and nothing else: the main address
# first, because the server uses the first one as its own, then any older address that must
# keep working, such as
# https://ozidelivery.co.uk,https://www.ozidelivery.co.uk,https://lobster-app-3ilv6.ondigitalocean.app
ALLOWED_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Store configuration
# ---------------------------------------------------------------------------
# Absolute or repo-relative path to the store configuration file. Everything about the
# supermarket lives there, never in code (Rule Nine).
STORE_CONFIG_PATH=./config/store.json

# Fill an empty catalogue when the server starts, so a fresh database is a shop rather
# than a blank page. It only ever writes catalogue items, never people: the right to work
# and criminal record checks behind a Runner are made by a person, never by a seed. Set to
# false once the catalogue comes from somewhere else.
SEED_ON_START=true

# ---------------------------------------------------------------------------
# Database — the local docker compose service in docker-compose.yml
# ---------------------------------------------------------------------------
POSTGRES_USER=ozidelivery
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ozidelivery
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ozidelivery:change_me_locally@localhost:5433/ozidelivery?schema=public

# ---------------------------------------------------------------------------
# Stripe — an account used by the service and nothing else
# ---------------------------------------------------------------------------
# The service never stores card numbers (Rule Ten). Card details go straight from the
# Shopper browser to Stripe; we keep only a payment method id and the last four digits.
STRIPE_SECRET_KEY=sk_test_placeholder_do_not_use
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_do_not_use
STRIPE_WEBHOOK_SECRET=whsec_placeholder_do_not_use
# The Runner spending card from Stripe Issuing (docs/changes/runner-card.md). Leave false until
# Issuing is switched on for the Stripe account and the Issuing events are added to the webhook
# (DEPLOY.md, Switching on the Runner spending card). While false, Runners pay with their own card
# and are paid back straight away (ruling 55).
STRIPE_ISSUING_ENABLED=false

# ---------------------------------------------------------------------------
# Authentication — phone plus one time code
# ---------------------------------------------------------------------------
# Secret used to sign session tokens. Generate with: openssl rand -base64 48
AUTH_TOKEN_SECRET=replace_with_a_long_random_value_at_least_32_chars
AUTH_TOKEN_TTL_HOURS=720
OTP_LENGTH=6
OTP_TTL_SECONDS=600
# In development the one time code is written to the server log instead of being sent.
# Set to sms, with the three Twilio values below, to send real texts.
OTP_DELIVERY=log

# The demo sign-in for app store reviewers (ruling 60). Off unless both are set. One UK mobile
# number that accepts one fixed code without a text, opening a labelled demo account whose orders
# charge no card and reach no Runner. The code is a secret: set it only in the server's
# environment (DigitalOcean) and in App Store Connect and Play Console, never in the repository.
DEMO_SIGNIN_PHONE=
DEMO_SIGNIN_CODE=

# Twilio, for sending sign-in codes. An account used by the service and nothing else.
TWILIO_ACCOUNT_SID=replace_with_the_account_sid_from_twilio
TWILIO_AUTH_TOKEN=replace_with_the_auth_token_from_twilio
# A Twilio number in +44 form, a Messaging Service id (MG...), or a sender name of at most
# eleven characters, such as OziDelivery.
TWILIO_FROM=replace_with_the_number_or_name_texts_come_from

# Web Push, for notifications when a Runner has a question. Make the pair once with
# node packages/api/scripts/push-keys.mjs. Both, or none. VAPID_SUBJECT is optional: without
# it the first ALLOWED_ORIGIN is used, if it is https.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# LiveKit, for in-app calls (Section F). All three, or none. The URL starts wss:// and comes
# from the LiveKit project's settings, with an API key and its secret. See DEPLOY.md.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Oluoma Voice (ruling 53): our own voice engine, for Ozi's speaking and hearing. Both, or none;
# with none, the app uses the phone's own speech. The address is where the engine runs, such
# as https://voice.example.com, and the key is the one the engine printed for this product.
# The key stays on the server: browsers only ever get five-minute tokens. See DEPLOY.md.
OLUOMA_VOICE_URL=
OLUOMA_VOICE_KEY=

# The language model behind Ozi (ruling 69): the provider's API key, and which model (left
# empty, the smallest current one). Without the key, the phrase book and the parser work alone.
LANGUAGE_MODEL_KEY=
LANGUAGE_MODEL=

# The business mailbox Ozi reads every five minutes (ruling 76). Off unless the host, user and
# password are all real. Nothing about where mail is delivered changes: no DNS or MX records.
# Yvette: in cPanel, open Email Accounts, choose the business address, then Connect Devices.
# Under "Secure SSL/TLS Settings" it shows the Incoming Server (use it for EMAIL_IMAP_HOST,
# with port 993) and the Outgoing Server (EMAIL_SMTP_HOST, port 465). The username is the full
# email address; the password is that mailbox's own password. The password is a secret: set it
# only in the server's environment (DigitalOcean), never in the repository.
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
# Optional, for automatic replies only: the same user and password are used.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
# "on" lets Ozi answer simple customer questions by email itself. Anything else is off.
EMAIL_AUTO_REPLY=off

# Recording staff calls (ruling 77): LiveKit Egress records the sound of each call from the
# company into S3-compatible storage. DigitalOcean Spaces (about $5 a month) can hold them:
# create a Space (for example in London, lon1), then a Spaces access key under API. The endpoint
# is like lon1.digitaloceanspaces.com, the region like lon1. The secret is a secret: set it only
# in the server's environment, never in the repository. Without all five, calls still work and
# the log says "not recorded: recording storage not set up". Recordings are deleted after 90 days.
RECORDING_S3_ENDPOINT=
RECORDING_S3_BUCKET=
RECORDING_S3_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_REGION=

# ---------------------------------------------------------------------------
# Web build-time values (Vite only exposes variables prefixed with VITE_)
# ---------------------------------------------------------------------------
# Where the browser should call the API. Baked into the bundle at build time. On
# DigitalOcean the web app and the API share a hostname, so this is /api there.
VITE_API_URL=http://localhost:8080
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_do_not_use
