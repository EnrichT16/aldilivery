# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
packages/web/dev-dist/

# Secrets — never commit these
.env
.env.*
!.env.example

# Prisma generated client
packages/api/src/generated/
packages/api/prisma/*.db

# Test and coverage output
coverage/
.vitest/

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local database volume
.postgres-data/

# The phone apps' native projects are generated into packages/mobile/build (covered by build/
# above) from config/store.json each time, and never committed. docs/APP_STORES.md says why.
# Store signing files, if anyone ever puts one in the repository folder by mistake.
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
