{
  "name": "@aldilivery/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "The App Store and Google Play apps: Capacitor shells around the built web app. The native projects are generated into build/ from config/store.json, never committed. See docs/APP_STORES.md.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:web-only": "node scripts/build.ts --skip-native",
    "assets": "node scripts/build.ts --assets",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
