// The data model.
//
// Two things to notice before reading any further.
//
// Rule Ten: there is no field anywhere in this schema capable of holding a card number.
// `PaymentMethod` holds a Stripe payment method identifier and the last four digits, which
// is all that is needed to say "the card ending 4242" back to a Shopper. Card details go
// from the Shopper's browser to Stripe and never touch this database.
//
// Rule Eight: this database belongs to the service alone. It shares no table, no user table
// and no payment account with any other product.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------------

/// The two checks a person must make before a Runner is offered any job.
enum RunnerCheckKind {
  right_to_work
  criminal_record
}

enum RunnerCheckOutcome {
  verified
  withdrawn
}

enum VehicleType {
  on_foot
  bicycle
  motorbike
  car
  van
}

/// What a Shopper wants to happen when something is not on the shelf.
enum SubstitutionPreference {
  no_substitutes
  similar_item
  ask_me
}

enum OrderStatus {
  draft
  confirmed
  paid
  offered
  accepted
  shopping
  receipt_submitted
  delivering
  delivered
  completed
  cancelled
  refunded
}

/// What actually happened to a single line of an order once the Runner was at the shelf.
/// What a Shopper wants when their Runner cannot find something.
enum ItemAnswer {
  similar
  leave_out
}

enum SubstitutionOutcome {
  pending
  supplied
  substituted
  unavailable
}

/// Where a catalogue item's price estimate came from. Configuration decides which mode is
/// live; see `store.catalogueSource.mode` in config/store.json.
enum CatalogueItemSource {
  partner_feed
  community
}

/// The cool bag deposit is withheld from a Runner's early payouts and released after their
/// twentieth completed delivery. It is never a reduction of the five pounds earned.
enum CoolBagDepositStatus {
  not_started
  withholding
  held
  released
}

enum JobOfferOutcome {
  pending
  accepted
  declined
  expired
  superseded
}

enum SetFrequency {
  weekly
  fortnightly
  monthly
}

enum AccountRole {
  shopper
  runner
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Shopper {
  id                   String                 @id @default(cuid())
  displayName          String
  /// Short, speakable, unique. Used instead of an email address.
  handle               String                 @unique
  phone                String                 @unique
  /// A hash of the Shopper's spoken code. The code itself is never stored.
  spokenCodeHash       String?
  /// The Shopper's customer at Stripe, which saved cards are attached to so they can be used again.
  stripeCustomerId     String?                @unique
  /// Ozi Recipes is unlocked until then.
  recipePassUntil      DateTime?
  /// Ozi Plus is on until then (bought, or shared from a family plan's owner).
  plusUntil            DateTime?
  /// Whether the Plus this Shopper bought is the family plan, which others can join.
  plusFamily           Boolean                @default(false)
  /// The code others type to join this Shopper's family plan.
  familyCode           String?                @unique
  /// The Shopper whose family plan this one has joined.
  familyOwnerId        String?
  /// Gift card money waiting to be used, in pence.
  creditPence          Int                    @default(0)
  preferredLanguage    String                 @default("en-GB")
  /// Free text the Runner reads at the door: "knock loudly, I am slow to the door".
  doorstepProtocol     String                 @default("")
  /// Where the shopping goes. Typed once when the account is set up, and shown back for
  /// checking on every order rather than assumed. Empty until the Shopper gives one: an
  /// account can exist before there is anywhere to deliver to.
  deliveryAddress      String                 @default("")
  substitutionDefault  SubstitutionPreference @default(ask_me)
  /// An upper limit the Shopper sets on the goods estimate. Never a minimum (Rule Four).
  budgetCapPence       Int?
  /// The four-digit PIN for saving addresses and changing the home address, hashed with a
  /// salt and a server secret. The PIN itself is never stored. Null until the Shopper
  /// chooses one, the first time they add or change an address.
  pinHash              String?
  /// Wrong PIN attempts in a row. Three locks the PIN for a while.
  pinFailedAttempts    Int                    @default(0)
  pinLockedUntil       DateTime?
  /// Set when the Shopper asks for deletion. The row survives for the recycle bin window
  /// and is removed afterwards. Deleting is never immediate and never silent.
  deletionScheduledFor DateTime?

  /// Which office or team at the organisation looks after this person.
  organisationOffice String?
  /// Optional, given by the person for analysis only: under_25, 25_44, 45_64, 65_plus.
  ageBand            String?
  /// The share link they came by, such as partner:<id> or organisation:<id>.
  joinedVia          String?
  organisationId     String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            Order[]
  sets              Set[]
  paymentMethods    PaymentMethod[]
  circleMemberships HouseholdCircleMember[]
  pushSubscriptions PushSubscription[]
  savedAddresses    SavedAddress[]

  @@index([deletionScheduledFor])
}

model Runner {
  id                     String        @id @default(cuid())
  name                   String
  phone                  String        @unique
  vehicleType            VehicleType   @default(on_foot)
  /// Every way the Runner said they might deliver.
  travelModes            VehicleType[] @default([])
  /// Their own ID, shown to them and used in the link they share.
  referralCode           String        @unique
  /// The ID of whoever invited them.
  referredBy             String?
  drivingLicenceVerified Boolean       @default(false)
  /// Accepted motor insurance covers them until this day.
  motorInsuranceUntil    DateTime?

  /// Both checks must be true before a Runner may be offered any job.
  rightToWorkVerified         Boolean @default(false)
  criminalRecordCheckVerified Boolean @default(false)

  /// The Runner's own Stripe Connect account. Their money is transferred straight to it;
  /// The service never holds it (Rule Ten).
  stripeConnectedAccountId String?

  coolBagDepositStatus   CoolBagDepositStatus @default(not_started)
  coolBagWithheldPence   Int                  @default(0)
  completedDeliveryCount Int                  @default(0)

  /// Availability and last known position, used by the rotating fair queue.
  available          Boolean   @default(false)
  latitude           Float?
  longitude          Float?
  /// When this Runner last finished a job. The queue offers to whoever has waited longest.
  lastJobCompletedAt DateTime?

  /// The Runner agreement (ruling 55): when they agreed, to which version, and how (a tick on
  /// the screen, or a spoken yes). No job can be accepted until they have agreed to the current
  /// version.
  agreementAcceptedAt DateTime?
  agreementVersion    String?
  agreementChannel    String?

  /// How often Stripe sends what is in their own Stripe account on to their bank: weekly
  /// (the default) or daily (ruling 16). Pay still reaches their Stripe account after each job.
  payoutSchedule String @default("weekly")

  /// When they stopped being a Runner, closed by themselves or removed by staff, and why.
  leftAt                  DateTime?
  leftReason              String?
  leftBy                  String?
  /// The cool bag deposit paid back on leaving (docs/LEGAL_REVIEW.md), or why it waits.
  coolBagRefundedPence    Int?
  coolBagRefundedAt       DateTime?
  coolBagRefundTransferId String?
  coolBagRefundNote       String?

  /// Insurance reminders (ruling 14): which expiry date they were for, and the fewest days
  /// before it that a reminder has gone out (0 once it has run out).
  insuranceReminderFor  DateTime?
  insuranceReminderDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  offers    JobOffer[]
  payouts   RunnerPayout[]
  checks    RunnerCheck[]
  documents RunnerDocument[]
  sos       RunnerSos[]

  @@index([available, lastJobCompletedAt])
}

/// A council, charity or care provider that pays for Shoppers as service users.
model Organisation {
  id                 String  @id @default(cuid())
  name               String
  contactName        String
  contactEmail       String
  contactPhone       String?
  /// Free text, for example "30 days from invoice, purchase order required".
  invoiceTerms       String  @default("")
  active             Boolean @default(true)
  /// The code a person types in Settings to let this organisation see their orders.
  joinCode           String? @unique
  /// What the organisation means to spend in a month, if it says.
  monthlyBudgetPence Int?
  /// What one of their own staff going to the shops costs them, for the savings figure.
  staffTripCostPence Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The Shoppers this organisation supports.
  serviceUsers Shopper[]
}

/// A group of Shoppers who may order for one another — a daughter ordering for her father.
model HouseholdCircle {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members HouseholdCircleMember[]
}

/// Membership of a circle, with consent recorded explicitly. No one is added to a circle
/// without a recorded, timestamped consent.
model HouseholdCircleMember {
  id        String @id @default(cuid())
  circleId  String
  shopperId String

  circle  HouseholdCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  shopper Shopper         @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  /// Null until the Shopper has consented. A member without a consent timestamp has no
  /// powers in the circle.
  consentGivenAt    DateTime?
  /// How the consent was captured, for example "spoken to Ozi" or "typed on the web".
  consentMethod     String?
  /// Who recorded it, for the audit trail.
  consentRecordedBy String?
  canOrderForOthers Boolean   @default(false)

  createdAt DateTime @default(now())

  @@unique([circleId, shopperId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model CatalogueItem {
  id                  String              @id @default(cuid())
  name                String
  category            String
  /// An estimate only. The Shopper is charged the receipt, not the estimate.
  estimatedPricePence Int
  /// Rule Six: anything true here cannot reach a basket in version one.
  ageRestricted       Boolean             @default(false)
  source              CatalogueItemSource
  /// A reference from the upstream feed, when there is one.
  externalRef         String?
  lastSeenAt          DateTime            @default(now())
  /// Taken off sale, for example by a partner shop: never in a search, never in a basket.
  retired             Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  setItems   SetItem[]

  @@index([name])
  @@index([category])
  @@index([ageRestricted])
}

// ---------------------------------------------------------------------------
// Payment methods — Rule Ten
// ---------------------------------------------------------------------------

/// A saved card, as far as the service is concerned.
///
/// There is no card number field, no CVC field and no expiry-plus-number pairing that
/// could be reassembled into one. `lastFour` exists solely so a Shopper can be told which
/// card is about to be used.
model PaymentMethod {
  id        String  @id @default(cuid())
  shopperId String
  shopper   Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  stripePaymentMethodId String  @unique
  lastFour              String
  brand                 String?
  /// The card's region, checked against payments.supportedCardRegions in configuration.
  region                String?
  isDefault             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  sets   Set[]
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id        String      @id @default(cuid())
  shopperId String
  shopper   Shopper     @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(draft)

  runnerId String?
  runner   Runner? @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  setId String?
  set   Set?    @relation(fields: [setId], references: [id], onDelete: SetNull)

  /// What the Shopper was quoted, before the Runner reached the till.
  goodsEstimatePence Int
  feePence           Int
  totalEstimatePence Int

  /// What the till actually said. Null until the Runner submits the receipt.
  receiptTotalPence  Int?
  /// The fee recalculated against the receipt, and the amount finally charged.
  receiptFeePence    Int?
  finalTotalPence    Int?
  /// Gift card money used on this order, given back to the card once it was paid.
  creditAppliedPence Int  @default(0)

  /// "card" (Stripe) or "bank" (a transfer to the business account, ruling 50).
  paidBy         String    @default("card")
  /// The reference a bank transfer carries, so staff can match it.
  bankReference  String?   @unique
  bankReceivedAt DateTime?

  /// Rule One. The order may not reach a payment intent until this is set. It records the
  /// single explicit confirmation the Shopper gave, and how they gave it.
  spokenConfirmationAt  DateTime?
  confirmationChannel   String?
  confirmationStatement String?

  /// The doorstep instructions as they stood at the moment of confirmation, so a later
  /// edit to the Shopper's profile cannot change what the Runner was told to do.
  doorstepProtocolSnapshot String @default("")

  stripePaymentIntentId String?        @unique
  paymentMethodId       String?
  paymentMethod         PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  deliveryAddress String
  latitude        Float?
  longitude       Float?

  /// Orders sharing a pool identifier are delivered in one trip. Each still pays the
  /// Runner five pounds in full (Rule Two).
  poolId String?

  /// Recorded for the audit trail; always the constant, never a calculation.
  runnerPaymentPence Int     @default(500)
  runnerTransferId   String?

  /// Paying the Runner back for the shopping they bought with their own card (ruling 55).
  /// The amount is the till total that was accepted, never more than the order cap. The
  /// status is "paid", "waiting" (for a person to approve) or "owed" (their payout account
  /// was not ready; the payout sweep sends it). The transfer carries the reference
  /// reimburse:<order id>, so it can never be sent twice.
  reimbursementPence      Int?
  reimbursementStatus     String?
  reimbursementReason     String?
  reimbursementTransferId String?
  reimbursedAt            DateTime?
  reimbursementApprovedBy String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  items     OrderItem[]
  offers    JobOffer[]
  payout    RunnerPayout?
  questions ItemQuestion[]
  calls     Call[]

  @@index([status])
  @@index([reimbursementStatus])
  @@index([shopperId])
  @@index([poolId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  catalogueItemId String?
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)

  /// The name as the Shopper said it, kept even if the catalogue entry later changes.
  name                String
  quantity            Int    @default(1)
  estimatedPricePence Int

  /// What happened at the shelf.
  substitutionOutcome SubstitutionOutcome @default(pending)
  substitutedForName  String?
  actualPricePence    Int?
  note                String?

  questions ItemQuestion[]

  createdAt DateTime @default(now())
}

/// One offer of one job to one Runner, held for sixty seconds.
model JobOffer {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  offeredAt     DateTime        @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  outcome       JobOfferOutcome @default(pending)
  /// Where this Runner sat in the rotation when the offer was made, for auditing fairness.
  queuePosition Int
  distanceMiles Float?

  @@index([orderId, outcome])
  @@index([runnerId])
}

/// The record of money moved to a Runner. One per completed order.
model RunnerPayout {
  id       String @id @default(cuid())
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  /// Always five hundred. Recorded per payout so the audit trail is self evident.
  earnedPence           Int
  /// Held back towards the cool bag deposit, never taken from the earning.
  /// Taken towards a refund the Runner was found at fault for, a little from each job.
  recoveryWithheldPence Int     @default(0)
  coolBagWithheldPence  Int     @default(0)
  /// What actually moved to the Runner's own account in this transfer.
  transferredPence      Int
  stripeTransferId      String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Recurring orders — a "Set"
// ---------------------------------------------------------------------------

model Set {
  id        String  @id @default(cuid())
  shopperId String
  shopper   Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  name String

  deliveryAddress String
  latitude        Float?
  longitude       Float?

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  frequency SetFrequency
  /// 1 is Monday, 7 is Sunday.
  dayOfWeek Int
  /// Local time of day in 24 hour "HH:MM".
  timeOfDay String
  timezone  String       @default("Europe/London")

  active Boolean @default(true)

  nextFireAt DateTime

  /// Rule Five. A Set may not fire unless a notice went out thirty minutes beforehand.
  noticeSentAt           DateTime?
  /// Set when the Shopper replies with the one word skip. Cleared once the skipped
  /// occurrence has passed.
  skipRequestedForFireAt DateTime?
  lastFiredAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  SetItem[]
  orders Order[]

  @@index([active, nextFireAt])
}

model SetItem {
  id    String @id @default(cuid())
  setId String
  set   Set    @relation(fields: [setId], references: [id], onDelete: Cascade)

  catalogueItemId String?
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)

  name                String
  quantity            Int    @default(1)
  estimatedPricePence Int

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Authentication — phone plus a one time code
// ---------------------------------------------------------------------------

/// A one time code, stored as a hash. The code itself is never written down.
model OneTimeCode {
  id         String      @id @default(cuid())
  phone      String
  codeHash   String
  role       AccountRole @default(shopper)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int         @default(0)

  createdAt DateTime @default(now())

  @@index([phone, consumedAt])
}

/// Every time a person checked a Runner's documents, or took an approval back.
///
/// Only ever added to. The two flags on Runner are what job offers read; this is the record of
/// who set them, when, and on the strength of what, so the question "why was this person
/// allowed to deliver to somebody vulnerable" always has an answer. Copies of documents are
/// never kept here: only what kind of document was seen and a reference to it.
model RunnerCheck {
  id        String             @id @default(cuid())
  runnerId  String
  runner    Runner             @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  kind      RunnerCheckKind
  outcome   RunnerCheckOutcome
  /// What was seen, e.g. "Home Office share code checked on GOV.UK" or "Basic DBS certificate".
  evidence  String
  /// The name of the person who made the check.
  checkedBy String
  note      String             @default("")
  checkedAt DateTime           @default(now())

  @@index([runnerId])
}

/// A Runner telling the Shopper they cannot find something, and what the Shopper wants instead.
///
/// No phone numbers change hands: the question goes to the Shopper's screen, and the answer back
/// to the Runner's. If nobody answers within a few minutes the Shopper's own standing preference
/// decides, and where that was "ask me first" the item is left out — nothing is ever bought that
/// the Shopper did not agree to.
model ItemQuestion {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  askedAt     DateTime    @default(now())
  answer      ItemAnswer?
  /// `shopper` when they answered, `preference` when nobody did and their preference decided.
  answeredBy  String?
  answeredAt  DateTime?

  @@index([orderId])
}

/// A device a Shopper has allowed to show notifications. The browser's push address and the
/// keys for encrypting what is sent to it; no message is ever stored.
model PushSubscription {
  id        String   @id @default(cuid())
  shopperId String
  shopper   Shopper  @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([shopperId])
}

/// An address a Shopper has saved for orders sent somewhere other than home: a child at
/// university, a friend across town, a customer. Unlimited. Saving one needs the PIN; a voice
/// order never uses one, only the home address.
model SavedAddress {
  id        String   @id @default(cuid())
  shopperId String
  shopper   Shopper  @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  /// What the Shopper calls it: "Tom's halls", "Mum".
  label     String   @default("")
  address   String
  createdAt DateTime @default(now())

  @@index([shopperId])
}

/// An in-app call about an order (docs/BUILD_PROMPT.md, Section F), carried by LiveKit. No
/// telephone number is stored anywhere in it.
model Call {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopperId        String
  runnerId         String
  /// The LiveKit room: unguessable, one per call.
  roomName         String    @unique
  /// "shopper" or "runner".
  startedBy        String
  /// "ringing", "live" or "ended".
  status           String    @default("ringing")
  createdAt        DateTime  @default(now())
  endedAt          DateTime?
  /// What the Shopper said yes to (Rule One).
  priceStatement   String?
  priceAcceptedAt  DateTime?
  pencePerMinute   Int
  billedMinutes    Int       @default(0)
  chargePence      Int       @default(0)
  /// "pending", "not_due", "paid" or "outstanding".
  chargeStatus     String    @default("pending")
  paymentReference String?
  chargedAt        DateTime?
  legs             CallLeg[]

  @@index([orderId])
  @@index([shopperId, chargeStatus])
}

/// One person's part in a call.
model CallLeg {
  id               String    @id @default(cuid())
  callId           String
  call             Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  /// "shopper", "runner" or "guest".
  role             String
  identity         String
  name             String
  connectedSince   DateTime?
  secondsConnected Int       @default(0)
  inviteCodeHash   String?   @unique
  priceStatement   String?
  createdAt        DateTime  @default(now())

  @@unique([callId, identity])
}

/// A document a Runner sent in. The photograph is removed once a person has decided, except the
/// face photograph, which is shown to the Shopper at the door.
model RunnerDocument {
  id          String    @id @default(cuid())
  runnerId    String
  runner      Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  /// face_photo, right_to_work, dbs, driving_licence_front, driving_licence_back, insurance.
  kind        String
  image       Bytes?
  contentType String?
  shareCode   String?
  expiresOn   DateTime?
  /// submitted, accepted or rejected.
  status      String    @default("submitted")
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([runnerId])
  @@index([status])
}

/// Something a Runner told us. No Runner is recorded when they chose to be anonymous.
model RunnerFeedback {
  id        String   @id @default(cuid())
  runnerId  String?
  message   String
  createdAt DateTime @default(now())
}

/// Something that went wrong with an order, with evidence, decided by a person.
model ProblemReport {
  id                   String            @id @default(cuid())
  orderId              String
  /// "runner" or "shopper".
  reportedBy           String
  reporterId           String
  summary              String
  refundRequestedPence Int               @default(0)
  /// "open" or "decided".
  status               String            @default("open")
  decideBy             DateTime
  /// shopper_at_fault, runner_at_fault, platform_at_fault, shop_at_fault or no_fault.
  decision             String?
  refundPence          Int               @default(0)
  refundReference      String?
  decisionNote         String?
  decidedBy            String?
  decidedAt            DateTime?
  createdAt            DateTime          @default(now())
  evidence             ProblemEvidence[]

  @@index([status, decideBy])
  @@index([orderId])
}

/// A voice note, photo or written note sent as evidence.
model ProblemEvidence {
  id          String        @id @default(cuid())
  reportId    String
  report      ProblemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  addedBy     String
  /// voice_note, photo or note.
  kind        String
  data        Bytes?
  contentType String?
  text        String?
  createdAt   DateTime      @default(now())

  @@index([reportId])
}

/// What a Runner owes after being found at fault, recovered a little from each job.
model RunnerRecovery {
  id             String    @id @default(cuid())
  runnerId       String
  reportId       String
  amountPence    Int
  recoveredPence Int       @default(0)
  writtenOff     Boolean   @default(false)
  /// Who wrote it off when the Runner left, and when (at or below problems.writeOffUpToPence).
  writtenOffBy   String?
  writtenOffAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([runnerId])
}

/// Ozi Finds It (7 October 2026): something hard to find, looked for by a person in up to three
/// shops, for a small finder fee agreed first. Given back if it cannot be found.
model FindRequest {
  id              String    @id @default(cuid())
  shopperId       String
  description     String
  feePence        Int
  /// The payment the fee was taken by; null when Ozi Plus covered it.
  chargeId        String?
  status          String    @default("looking")
  foundName       String?
  foundShop       String?
  foundPricePence Int?
  catalogueItemId String?
  refundId        String?
  note            String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([shopperId])
  @@index([status])
}

/// A gift card (7 October 2026): bought with a card, given as a code, kept as credit.
model GiftCard {
  id                  String    @id @default(cuid())
  code                String    @unique
  amountPence         Int
  buyerShopperId      String
  chargeId            String
  recipientName       String    @default("")
  message             String    @default("")
  redeemedByShopperId String?
  redeemedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([buyerShopperId])
}

/// An organisation asking to work with us (7 October 2026). A person rings them back.
model OrganisationEnquiry {
  id           String   @id @default(cuid())
  organisation String
  contactName  String
  telephone    String
  email        String   @default("")
  people       String   @default("")
  message      String   @default("")
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

/// Somebody who runs the service, with their own admin sign-in (7 October 2026). What they can
/// see follows their role (packages/api/src/lib/staff.ts).
model StaffMember {
  id                 String    @id @default(cuid())
  name               String
  username           String    @unique
  /// scrypt, salted. Never the password.
  passwordHash       String
  role               String
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastSignInAt       DateTime?
  /// The founder's own account: the only one that sees the money.
  isOwner            Boolean   @default(false)
  /// The owner's 7-character passcode (6 digits and a special character), hashed.
  passcodeHash       String?
  /// Two-step codes from an authenticator app, if the owner turns them on.
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  /// For family and investor accounts: the parts the owner has switched on, comma separated.
  allowedAreas       String    @default("")
  /// Raised to sign every session of this account out at once.
  sessionVersion     Int       @default(0)
  createdAt          DateTime  @default(now())
}

/// A local shop on the monthly partner plan (7 October 2026): its own sign-in, its own
/// products, approved by us before Shoppers see them.
model PartnerShop {
  id             String    @id @default(cuid())
  name           String
  address        String    @default("")
  telephone      String    @default("")
  about          String    @default("")
  monthlyPence   Int
  /// The plan is paid up to here. Products show only while it is.
  paidUntil      DateTime?
  active         Boolean   @default(true)
  /// Ozi mentions, an extra on top of the plan: none, spotlight or plus.
  spotlight      String    @default("none")
  spotlightUntil DateTime?
  createdAt      DateTime  @default(now())
}

/// A product a partner shop sent in. Shoppers see it once a person has approved it.
model PartnerProduct {
  id              String    @id @default(cuid())
  partnerShopId   String
  name            String
  pricePence      Int
  tags            String    @default("")
  expiresOn       DateTime?
  photo           Bytes?
  photoType       String?
  status          String    @default("pending")
  note            String?
  catalogueItemId String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([partnerShopId])
  @@index([status])
}

/// Somebody signing in for a partner shop or an organisation, each with their own password.
model BusinessUser {
  id                 String    @id @default(cuid())
  kind               String
  partnerShopId      String?
  organisationId     String?
  name               String
  office             String    @default("")
  username           String    @unique
  passwordHash       String
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastSignInAt       DateTime?
  createdAt          DateTime  @default(now())
}

/// What a Shop Partner has paid us: the plan, Spotlight or Spotlight Plus, a month at a time.
model PartnerPayment {
  id            String   @id @default(cuid())
  partnerShopId String
  kind          String
  amountPence   Int
  months        Int
  coversUntil   DateTime
  recordedBy    String
  paidAt        DateTime @default(now())

  @@index([partnerShopId])
}

/// Each time Ozi mentions a Spotlight shop to a Shopper, for the weekly limit and the shop's report.
model SpotlightMention {
  id            String   @id @default(cuid())
  partnerShopId String
  /// A one-way code for the Shopper, never their name or number.
  shopperKey    String
  query         String
  at            DateTime @default(now())

  @@index([shopperKey, at])
  @@index([partnerShopId, at])
}

/// Business analysis (7 October 2026): what happened, when and where, with no names, numbers or
/// addresses. People appear only as one-way codes; places only as postcode districts.
model AnalyticsEvent {
  id              String   @id @default(cuid())
  at              DateTime @default(now())
  kind            String
  shopperKey      String?
  runnerKey       String?
  shop            String?
  area            String?
  toArea          String?
  ageBand         String?
  viaOrganisation Boolean  @default(false)
  itemCount       Int      @default(0)
  goodsPence      Int      @default(0)
  categories      String   @default("")
  query           String?
  travelMode      String?

  @@index([at])
  @@index([kind, at])
  @@index([shop, at])
}

/// Money in and out (7 October 2026): every payment taken and every refund given, by gateway.
/// Seen only by the owner.
model IncomeRecord {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  gateway     String
  kind        String
  amountPence Int
  reference   String

  @@index([at])
}

/// What Ozi was asked and could not answer, for a person to approve an answer (ruling 49).
/// Never anything with a banned word or anything that looks personal; who said it is not kept.
model LearnedPhrase {
  id           String    @id @default(cuid())
  account      String
  text         String
  timesHeard   Int       @default(1)
  firstHeardAt DateTime
  lastHeardAt  DateTime
  status       String    @default("waiting")
  reply        String?
  decidedBy    String?
  decidedAt    DateTime?

  @@unique([account, text])
  @@index([status, timesHeard])
}

/// A Runner pressing SOS (Section M): where they are, kept up to date while it is on, and a
/// private link for the owner that stops working. Never anything about the Shopper's phone.
model RunnerSos {
  id             String    @id @default(cuid())
  runnerId       String
  runner         Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  /// The job they were on, if any.
  orderId        String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  endedBy        String?
  latitude       Float?
  longitude      Float?
  accuracyMetres Float?
  locationAt     DateTime?
  /// The hash of the code in the private link. Never the code itself.
  linkCodeHash   String    @unique
  linkExpiresAt  DateTime
  alertSentAt    DateTime?
  alertProblem   String?

  @@index([runnerId, endedAt])
}

/// The private referral reward (rulings 12 and 16), given by the owner. Not announced.
model ReferralReward {
  id              String   @id @default(cuid())
  /// Whose share link: shopper:<handle> or runner:<Runner ID>.
  referrer        String
  qualifyingCount Int
  amountPence     Int
  /// credit (a Shopper's credit), transfer (a Runner's own Stripe account) or by_hand.
  method          String
  reference       String?
  decidedBy       String
  createdAt       DateTime @default(now())

  @@index([referrer])
}
