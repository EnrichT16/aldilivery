// The data model.
//
// Two things to notice before reading any further.
//
// Rule Ten: there is no field anywhere in this schema capable of holding a card number.
// `PaymentMethod` holds a Stripe payment method identifier and the last four digits, which
// is all that is needed to say "the card ending 4242" back to a Shopper. Card details go
// from the Shopper's browser to Stripe and never touch this database.
//
// Rule Eight: this database belongs to the service alone. It shares no table, no user table
// and no payment account with any other product.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------------

/// The two checks a person must make before a Runner is offered any job.
enum RunnerCheckKind {
  right_to_work
  criminal_record
}

enum RunnerCheckOutcome {
  verified
  withdrawn
}

enum VehicleType {
  on_foot
  bicycle
  motorbike
  car
  van
}

/// What a Shopper wants to happen when something is not on the shelf.
enum SubstitutionPreference {
  no_substitutes
  similar_item
  ask_me
}

enum OrderStatus {
  draft
  confirmed
  paid
  offered
  accepted
  shopping
  receipt_submitted
  delivering
  delivered
  completed
  cancelled
  refunded
}

/// What actually happened to a single line of an order once the Runner was at the shelf.
/// What a Shopper wants when their Runner cannot find something.
enum ItemAnswer {
  similar
  leave_out
}

enum SubstitutionOutcome {
  pending
  supplied
  substituted
  unavailable
}

/// Where a catalogue item's price estimate came from. Configuration decides which mode is
/// live; see `store.catalogueSource.mode` in config/store.json.
enum CatalogueItemSource {
  partner_feed
  community
}

/// The cool bag deposit is withheld from a Runner's early payouts and released after their
/// twentieth completed delivery. It is never a reduction of the five pounds earned.
enum CoolBagDepositStatus {
  not_started
  withholding
  held
  released
}

enum JobOfferOutcome {
  pending
  accepted
  declined
  expired
  superseded
}

enum SetFrequency {
  weekly
  fortnightly
  monthly
}

enum AccountRole {
  shopper
  runner
  partner
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Shopper {
  id                      String                 @id @default(cuid())
  displayName             String
  /// Short, speakable, unique. Used instead of an email address.
  handle                  String                 @unique
  phone                   String                 @unique
  /// A hash of the Shopper's spoken code. The code itself is never stored.
  spokenCodeHash          String?
  /// The Shopper's customer at Stripe, which saved cards are attached to so they can be used again.
  stripeCustomerId        String?                @unique
  /// Ozi Recipes is unlocked until then.
  recipePassUntil         DateTime?
  /// The monthly plan the Shopper chose to join (ruling 58): "membership", "plus" or "family".
  /// Null is pay as you go. A family member carries the payer's plan.
  plan                    String?
  /// The plan is paid up until then (or shared from the Family and Carer plan's payer).
  planUntil               DateTime?
  /// The Shopper chose to have the plan taken monthly, until they cancel. Never set without
  /// their yes; cancelling sets it false and the plan runs to the end of the paid month.
  planRenews              Boolean                @default(false)
  /// When they joined, with their yes, and when they cancelled.
  planStartedAt           DateTime?
  planCancelledAt         DateTime?
  /// The first month's membership is free (with pay-as-you-go delivery) until then.
  freeMonthUntil          DateTime?
  /// The reminder that the free month is ending, sent once.
  freeMonthReminderSentAt DateTime?
  /// Ozi Plus: the last friendly check-in after a while without an order.
  checkInSentAt           DateTime?
  /// Family and Carer: orders by members above this total wait for the payer's approval.
  approvalLimitPence      Int?
  /// Family and Carer: when the payer's last weekly summary went.
  weeklySummarySentAt     DateTime?
  /// The code others type to join this Shopper's family plan.
  familyCode              String?                @unique
  /// The Shopper whose family plan this one has joined.
  familyOwnerId           String?
  /// Gift card money waiting to be used, in pence.
  creditPence             Int                    @default(0)
  /// How much of creditPence is "Unused Runner fee credit" (ruling 61), shown in the account.
  unusedRunnerFeeCreditPence Int                @default(0)
  preferredLanguage       String                 @default("en-GB")
  /// Free text the Runner reads at the door: "knock loudly, I am slow to the door".
  doorstepProtocol        String                 @default("")
  /// Where the shopping goes. Typed once when the account is set up, and shown back for
  /// checking on every order rather than assumed. Empty until the Shopper gives one: an
  /// account can exist before there is anywhere to deliver to.
  deliveryAddress         String                 @default("")
  substitutionDefault     SubstitutionPreference @default(ask_me)
  /// An upper limit the Shopper sets on the goods estimate. Never a minimum (Rule Four).
  budgetCapPence          Int?
  /// The four-digit PIN for saving addresses and changing the home address, hashed with a
  /// salt and a server secret. The PIN itself is never stored. Null until the Shopper
  /// chooses one, the first time they add or change an address.
  pinHash                 String?
  /// Wrong PIN attempts in a row. Three locks the PIN for a while.
  pinFailedAttempts       Int                    @default(0)
  pinLockedUntil          DateTime?
  /// Set when the Shopper asks for deletion. The row survives for the recycle bin window
  /// and is removed afterwards. Deleting is never immediate and never silent.
  deletionScheduledFor    DateTime?
  /// When the account was removed after closing: personal details taken off, money records kept.
  erasedAt                DateTime?
  /// The app store reviewers' demo account (ruling 60): its orders charge no card and reach
  /// no Runner.
  isDemo                  Boolean                @default(false)

  /// Which office or team at the organisation looks after this person.
  organisationOffice String?
  /// Optional, given by the person for analysis only: under_25, 25_44, 45_64, 65_plus.
  ageBand            String?
  /// The share link they came by, such as partner:<id> or organisation:<id>.
  joinedVia          String?
  organisationId     String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  /// When the person agreed to link to the organisation (30 October 2026, UK GDPR). The
  /// organisation sees only orders placed from this moment on.
  organisationConsentAt      DateTime?
  /// Which consent wording they agreed to (ORGANISATION_CONSENT_VERSION in packages/core).
  organisationConsentVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            Order[]
  sets              Set[]
  paymentMethods    PaymentMethod[]
  circleMemberships HouseholdCircleMember[]
  pushSubscriptions PushSubscription[]
  savedAddresses    SavedAddress[]

  @@index([deletionScheduledFor])
}

model Runner {
  id                     String        @id @default(cuid())
  name                   String
  phone                  String        @unique
  vehicleType            VehicleType   @default(on_foot)
  /// Every way the Runner said they might deliver.
  travelModes            VehicleType[] @default([])
  /// Their own ID, shown to them and used in the link they share.
  referralCode           String        @unique
  /// The ID of whoever invited them.
  referredBy             String?
  drivingLicenceVerified Boolean       @default(false)
  /// Accepted motor insurance covers them until this day.
  motorInsuranceUntil    DateTime?

  /// Both checks must be true before a Runner may be offered any job.
  rightToWorkVerified         Boolean @default(false)
  criminalRecordCheckVerified Boolean @default(false)

  /// The Runner's own Stripe Connect account. Their money is transferred straight to it;
  /// The service never holds it (Rule Ten).
  stripeConnectedAccountId String?

  coolBagDepositStatus   CoolBagDepositStatus @default(not_started)
  coolBagWithheldPence   Int                  @default(0)
  completedDeliveryCount Int                  @default(0)

  /// Availability and last known position, used by the rotating fair queue.
  available          Boolean   @default(false)
  latitude           Float?
  longitude          Float?
  /// When this Runner last finished a job. The queue offers to whoever has waited longest.
  lastJobCompletedAt DateTime?

  /// The Runner agreement (ruling 55): when they agreed, to which version, and how (a tick on
  /// the screen, or a spoken yes). No job can be accepted until they have agreed to the current
  /// version.
  agreementAcceptedAt DateTime?
  agreementVersion    String?
  agreementChannel    String?

  /// How often Stripe sends what is in their own Stripe account on to their bank: weekly
  /// (the default) or daily (ruling 16). Pay still reaches their Stripe account after each job.
  payoutSchedule String @default("weekly")

  /// When they stopped being a Runner, closed by themselves or removed by staff, and why.
  leftAt                  DateTime?
  leftReason              String?
  leftBy                  String?
  /// The cool bag deposit paid back on leaving (docs/LEGAL_REVIEW.md), or why it waits.
  coolBagRefundedPence    Int?
  coolBagRefundedAt       DateTime?
  coolBagRefundTransferId String?
  coolBagRefundNote       String?
  /// When a Runner who left had their personal details removed, after the same days to change
  /// their mind as a Shopper (ruling 60). Pay records stay, as money records.
  erasedAt                DateTime?
  /// The app store reviewers' demo Runner (ruling 60): never offered a real job.
  isDemo                  Boolean   @default(false)

  /// Insurance reminders (ruling 14): which expiry date they were for, and the fewest days
  /// before it that a reminder has gone out (0 once it has run out).
  insuranceReminderFor  DateTime?
  insuranceReminderDays Int?

  /// How they pay at the till (9 October 2026): "card", the spending card from Stripe Issuing,
  /// loaded for each order, or "own", their own card and paid back straight away (ruling 55).
  payMethod              String    @default("own")
  /// Stripe Issuing: the cardholder and the virtual card. Identifiers and the last four digits
  /// only; the card number never passes through this service (Rule Ten).
  issuingCardholderId    String?
  issuingCardId          String?   @unique
  cardLast4              String?
  /// "active" while loaded for an order, "inactive" (frozen) otherwise.
  cardStatus             String?
  /// When and from where they accepted the cardholder terms, which Stripe requires.
  issuingTermsAcceptedAt DateTime?
  issuingTermsAcceptedIp String?
  /// When they agreed that the automatic check may compare their face photo with the photo on
  /// their ID (ruling 74). Null: no face comparison is made by it; a person does it instead.
  faceMatchConsentAt     DateTime?

  /// Areas (Anthony, 30 October 2026): the postcode where they live, which gives their area. A
  /// Runner is only ever offered jobs in their own area.
  homePostcode        String    @default("")
  /// When `latitude` and `longitude` were last shared by their phone. Older than
  /// `areas.livePositionMinutes`, their home postcode's place is used instead.
  locationAt          DateTime?
  /// When a person accepted their face photo. No job is offered before it, as the Runner
  /// agreement says (Anthony, 30 October 2026).
  facePhotoAcceptedAt DateTime?
  /// When they confirmed at sign-up that they are 18 or over.
  adultConfirmedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardAuthorizations CardAuthorization[]
  orders             Order[]
  offers             JobOffer[]
  /// Jobs the office sent straight to this Runner, outside the queue (ruling 80).
  allocations        JobAllocation[]
  /// Devices where this Runner allowed notifications, for a job the office sends (ruling 80).
  pushSubscriptions  PushSubscription[]
  payouts            RunnerPayout[]
  checks             RunnerCheck[]
  documents          RunnerDocument[]
  sos                RunnerSos[]

  @@index([available, lastJobCompletedAt])
}

/// A council, charity or care provider that pays for Shoppers as service users.
model Organisation {
  id                 String  @id @default(cuid())
  name               String
  contactName        String
  contactEmail       String
  contactPhone       String?
  /// Free text, for example "30 days from invoice, purchase order required".
  invoiceTerms       String  @default("")
  active             Boolean @default(true)
  /// The code a person types in Settings to let this organisation see their orders.
  joinCode           String? @unique
  /// What the organisation means to spend in a month, if it says.
  monthlyBudgetPence Int?
  /// What one of their own staff going to the shops costs them, for the savings figure.
  staffTripCostPence Int?
  /// Where it is, which gives its area (Anthony, 30 October 2026). Empty until given.
  postcode           String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The Shoppers this organisation supports.
  serviceUsers Shopper[]
}

/// A group of Shoppers who may order for one another — a daughter ordering for her father.
model HouseholdCircle {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members HouseholdCircleMember[]
}

/// Membership of a circle, with consent recorded explicitly. No one is added to a circle
/// without a recorded, timestamped consent.
model HouseholdCircleMember {
  id        String @id @default(cuid())
  circleId  String
  shopperId String

  circle  HouseholdCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  shopper Shopper         @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  /// Null until the Shopper has consented. A member without a consent timestamp has no
  /// powers in the circle.
  consentGivenAt    DateTime?
  /// How the consent was captured, for example "spoken to Ozi" or "typed on the web".
  consentMethod     String?
  /// Who recorded it, for the audit trail.
  consentRecordedBy String?
  canOrderForOthers Boolean   @default(false)

  createdAt DateTime @default(now())

  @@unique([circleId, shopperId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model CatalogueItem {
  id                  String              @id @default(cuid())
  name                String
  category            String
  /// An estimate only. The Shopper is charged the receipt, not the estimate.
  estimatedPricePence Int
  /// Rule Six: anything true here cannot reach a basket in version one.
  ageRestricted       Boolean             @default(false)
  source              CatalogueItemSource
  /// A reference from the upstream feed, when there is one.
  externalRef         String?
  lastSeenAt          DateTime            @default(now())
  /// Taken off sale, for example by a partner shop: never in a search, never in a basket.
  retired             Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  setItems   SetItem[]

  @@index([name])
  @@index([category])
  @@index([ageRestricted])
}

// ---------------------------------------------------------------------------
// Payment methods — Rule Ten
// ---------------------------------------------------------------------------

/// A saved card, as far as the service is concerned.
///
/// There is no card number field, no CVC field and no expiry-plus-number pairing that
/// could be reassembled into one. `lastFour` exists solely so a Shopper can be told which
/// card is about to be used.
model PaymentMethod {
  id        String  @id @default(cuid())
  shopperId String
  shopper   Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  stripePaymentMethodId String  @unique
  lastFour              String
  brand                 String?
  /// The card's region, checked against payments.supportedCardRegions in configuration.
  region                String?
  isDefault             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  sets   Set[]
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id        String      @id @default(cuid())
  shopperId String
  shopper   Shopper     @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(draft)

  runnerId String?
  runner   Runner? @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  setId String?
  set   Set?    @relation(fields: [setId], references: [id], onDelete: SetNull)

  /// What the Shopper was quoted, before the Runner reached the till: the shopping at shop
  /// prices, the item charges on every unit, delivery, and all three together (ruling 58).
  goodsEstimatePence Int
  itemChargesPence   Int     @default(0)
  feePence           Int
  /// The extra delivery charge for an order past the plan's monthly allowance (ruling 73), or
  /// 0. In the total; not shop goods; kept by the business, never the Runner's.
  allowanceExtraPence Int    @default(0)
  totalEstimatePence Int
  /// A restaurant, café or takeaway order (Anthony, 30 October 2026): the partner it is from, and
  /// the discount it agreed for Ozi when the order was placed. The Shopper pays shop prices; the
  /// Runner pays the restaurant the discounted amount at the counter; Ozi keeps the difference.
  restaurantShopId          String?
  restaurantDiscountPercent Int     @default(0)
  /// Which delivery price applied: "payg", "membership" or "plus".
  deliveryPlan       String  @default("payg")
  /// Family and Carer: who pays (the payer's card, "one card pays"), and an order above the
  /// payer's limit waiting for their approval: "waiting", "approved" or "declined".
  payerShopperId     String?
  approvalStatus     String?

  /// What the till actually said. Null until the Runner submits the receipt.
  receiptTotalPence  Int?
  /// The fee recalculated against the receipt, and the amount finally charged.
  receiptFeePence    Int?
  finalTotalPence    Int?
  /// Gift card money used on this order, given back to the card once it was paid.
  creditAppliedPence Int  @default(0)

  /// "card" (Stripe) or "bank" (a transfer to the business account, ruling 50).
  paidBy         String    @default("card")
  /// The reference a bank transfer carries, so staff can match it.
  bankReference  String?   @unique
  bankReceivedAt DateTime?

  /// Rule One. The order may not reach a payment intent until this is set. It records the
  /// single explicit confirmation the Shopper gave, and how they gave it.
  spokenConfirmationAt  DateTime?
  confirmationChannel   String?
  confirmationStatement String?

  /// The doorstep instructions as they stood at the moment of confirmation, so a later
  /// edit to the Shopper's profile cannot change what the Runner was told to do.
  doorstepProtocolSnapshot String @default("")

  stripePaymentIntentId String?        @unique
  paymentMethodId       String?
  paymentMethod         PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  deliveryAddress String
  latitude        Float?
  longitude       Float?

  /// Orders sharing a pool identifier are delivered in one trip. Each still pays the
  /// Runner five pounds in full (Rule Two).
  poolId String?

  /// Recorded for the audit trail; always the constant, never a calculation.
  runnerPaymentPence Int     @default(500)
  runnerTransferId   String?

  /// Paying the Runner back for the shopping they bought with their own card (ruling 55).
  /// The amount is the till total that was accepted, never more than the order cap. The
  /// status is "paid", "waiting" (for a person to approve) or "owed" (their payout account
  /// was not ready; the payout sweep sends it). The transfer carries the reference
  /// reimburse:<order id>, so it can never be sent twice.
  reimbursementPence      Int?
  reimbursementStatus     String?
  reimbursementReason     String?
  reimbursementTransferId String?
  reimbursedAt            DateTime?
  reimbursementApprovedBy String?

  /// A till total a person must settle with the Shopper (a large extra, a bank transfer, a
  /// charge or refund that failed): "needs_person" until it is settled, then "settled", with
  /// why, who settled it and when. Shown on the owner's till screen.
  tillStatus    String?
  tillReason    String?
  tillSettledBy String?
  tillSettledAt DateTime?

  /// Paid at the till with the spending card ("card") or the Runner's own card ("own"),
  /// what the card was loaded with for this order, what it spent, and at which shop.
  payMethodUsed  String?
  cardLimitPence Int?
  cardSpentPence Int?
  cardMerchant   String?

  /// The door safe word (T6): two easy words the Runner says at the door.
  doorWord String?

  /// For an order placed by a Set: which occurrence, so each occurrence is placed once only.
  setFireAt DateTime?

  /// When the delivery address and doorstep words were taken off, seven years on (retention).
  anonymisedAt DateTime?

  /// When the owner was texted that this large order is still waiting for a Runner with a car
  /// (ruling 59), so it is texted once only.
  waitingAlertSentAt DateTime?

  /// Split jobs (ruling 60). On the whole order: when it was split into parts because no Runner
  /// who could carry it took it in time. On each part: the whole order it belongs to, which part
  /// it is and of how many. A part carries only its own items, its own till total, Runner card
  /// load or pay-back, receipt photo and delivery; the Shopper's card is settled on the whole
  /// order once every part has a till total.
  splitAt       DateTime?
  splitParentId String?
  splitParent   Order?    @relation("SplitParts", fields: [splitParentId], references: [id], onDelete: Cascade)
  splitParts    Order[]   @relation("SplitParts")
  splitPart     Int?
  splitOf       Int?
  /// On a part (ruling 61): "motorbike" (a motorbike rider, or a car or van Runner) or "foot"
  /// (on foot or by bicycle). Null on a whole order and on parts split before ruling 61.
  splitMode     String?
  /// On a part (ruling 61): when it was planned, at the split or when the rest was planned again.
  splitPlannedAt DateTime?

  /// A basket over one order kept whole (ruling 61): linked orders sharing the first order's id,
  /// each order basketPart of basketOf. On a linked order after the first, where its extra
  /// Runner's delivery has got to (pending, charged, failed, transfer, waived, refunded,
  /// credited) and the card payment that took it.
  basketGroupId          String?
  basketPart             Int?
  basketOf               Int?
  extraDeliveryStatus    String?
  extraDeliveryPaymentId String?

  /// A demo order (ruling 60), placed by the app store reviewers' demo account: no card is
  /// charged and no Runner is ever sent.
  isDemo Boolean @default(false)

  /// Ordering now for a later day (ruling 78). The UK day it comes (YYYY-MM-DD) and its window
  /// (morning, afternoon, evening), or null for as soon as possible; when it is offered to
  /// Runners; how the money is taken (now, scheduled, bank); for "scheduled", when, how many
  /// tries so far, the next try, and where it has got to (waiting, retrying,
  /// needs_authentication, failed, paid); a link sent when the bank asked to check; when it was
  /// held unpaid at its offer time; and the Shopper's reminders.
  deliveryDay         String?
  deliveryWindow      String?
  offerAt             DateTime?
  chargePlan          String?
  chargeAt            DateTime?
  chargeTries         Int       @default(0)
  chargeNextTryAt     DateTime?
  chargeStatus        String?
  chargeLinkSentAt    DateTime?
  scheduledHeldAt     DateTime?
  reminderDayBeforeAt DateTime?
  reminderMorningAt   DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  acceptedAt   DateTime?
  deliveredAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  /// Why it was cancelled, in plain words, for the admin panel's cancellations list.
  cancelReason String?
  /// Goodwill refunds staff gave on this order, added up (16 October 2026).
  goodwillRefundedPence Int @default(0)

  items              OrderItem[]
  offers             JobOffer[]
  /// Sent straight to a chosen Runner by the office, outside the queue (ruling 80).
  allocations        JobAllocation[]
  payout             RunnerPayout?
  questions          ItemQuestion[]
  calls              Call[]
  cardAuthorizations CardAuthorization[]

  @@unique([setId, setFireAt])
  @@index([status])
  @@index([reimbursementStatus])
  @@index([tillStatus])
  @@index([shopperId])
  @@index([poolId])
  @@index([deliveryDay])
  @@unique([splitParentId, splitPart])
}

/// A photo of the till receipt, taken by the Runner when the till total goes in. Kept with the
/// order for the people approving a pay-back or settling the till.
model ReceiptPhoto {
  id          String   @id @default(cuid())
  orderId     String   @unique
  data        Bytes
  contentType String
  createdAt   DateTime @default(now())
}

/// One price seen for one thing (ruling 72): off a till receipt, from the open price database,
/// or from a web lookup. The catalogue estimate follows the best of them.
model PriceSighting {
  id              String   @id @default(cuid())
  catalogueItemId String?
  name            String
  pricePence      Int
  shop            String?
  /// receipt, open_prices or web.
  source          String
  orderId         String?
  barcode         String?
  seenAt          DateTime @default(now())

  @@index([catalogueItemId, seenAt])
  @@index([source, seenAt])
  @@index([seenAt])
}

/// What a Shopper said after a delivery (Section O). One per order, and the credit given for it,
/// whatever it says. Shops see only patterns, never who said what.
model ShopperFeedback {
  id          String   @id @default(cuid())
  orderId     String   @unique
  /// 1 to 5, if they gave one.
  rating      Int?
  /// The themes they picked, comma separated, from a fixed list.
  themes      String   @default("")
  message     String   @default("")
  creditPence Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  catalogueItemId String?
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)

  /// The name as the Shopper said it, kept even if the catalogue entry later changes.
  name                String
  quantity            Int    @default(1)
  estimatedPricePence Int

  /// What happened at the shelf.
  substitutionOutcome SubstitutionOutcome @default(pending)
  substitutedForName  String?
  actualPricePence    Int?
  note                String?
  /// A Shop Partner's thing (Anthony, 30 October 2026): its shop price for one, and what the
  /// Runner pays for one at the counter, kept as they were when the order was placed.
  shopPricePence      Int?
  counterPricePence   Int?

  questions ItemQuestion[]

  createdAt DateTime @default(now())
}

/// One offer of one job to one Runner, held for sixty seconds.
model JobOffer {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  offeredAt     DateTime        @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  outcome       JobOfferOutcome @default(pending)
  /// Where this Runner sat in the rotation when the offer was made, for auditing fairness.
  queuePosition Int
  distanceMiles Float?
  /// Offered from the door of another job, for a pickup nearby (ruling 64), before the queue.
  chained       Boolean         @default(false)
  /// Sent straight to this Runner by the office (ruling 80): a priority offer, held longer.
  allocated     Boolean         @default(false)

  @@index([orderId, outcome])
  @@index([runnerId])
}

/// A job the office sent straight to a chosen Runner, outside the queue (ruling 80, Anthony,
/// 24 October 2026). Queued for the Runner while their hands are full, ordered by when it was
/// allocated; offered to them alone, held for `allocation.allocatedHoldMinutes`; accepted by
/// them, or, declined or run out, sent to the backup Runner or back to the queue.
model JobAllocation {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runnerId        String
  runner          Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  /// Who has it next if this Runner says no or the time runs out, if the office chose one.
  backupRunnerId  String?
  /// A booked order sent before its offer time, on purpose.
  allowEarly      Boolean   @default(false)
  /// queued, offered, accepted, declined, expired or withdrawn.
  status          String    @default("queued")
  /// The staff member who sent it (null for the staff key), and their name as it was.
  allocatedById   String?
  allocatedByName String
  allocatedAt     DateTime  @default(now())
  /// The priority offer made to the Runner, once their hands were free.
  offerId         String?
  offeredAt       DateTime?
  settledAt       DateTime?
  /// Where the order went when this Runner did not take it: backup or queue.
  returnedTo      String?
  /// The allocation this one is the backup of, if it is one.
  backupOfId      String?

  @@index([runnerId, status])
  @@index([orderId])
  @@index([status])
}

/// The record of money moved to a Runner. One per completed order.
model RunnerPayout {
  id       String @id @default(cuid())
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  /// Always five hundred. Recorded per payout so the audit trail is self evident.
  earnedPence           Int
  /// Held back towards the cool bag deposit, never taken from the earning.
  /// Taken towards a refund the Runner was found at fault for, a little from each job.
  recoveryWithheldPence Int     @default(0)
  coolBagWithheldPence  Int     @default(0)
  /// What actually moved to the Runner's own account in this transfer.
  transferredPence      Int
  stripeTransferId      String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Recurring orders — a "Set"
// ---------------------------------------------------------------------------

model Set {
  id        String  @id @default(cuid())
  shopperId String
  shopper   Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  name String

  deliveryAddress String
  latitude        Float?
  longitude       Float?

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  frequency SetFrequency
  /// 1 is Monday, 7 is Sunday.
  dayOfWeek Int
  /// Local time of day in 24 hour "HH:MM".
  timeOfDay String
  timezone  String       @default("Europe/London")

  active Boolean @default(true)

  nextFireAt DateTime

  /// Rule Five. A Set may not fire unless a notice went out thirty minutes beforehand.
  noticeSentAt           DateTime?
  /// Set when the Shopper replies with the one word skip. Cleared once the skipped
  /// occurrence has passed.
  skipRequestedForFireAt DateTime?
  lastFiredAt            DateTime?
  /// When the Shopper agreed that each occurrence is sent and paid for by itself after the
  /// notice, and the words they agreed to (Rule One). Null: a reminder only, nothing is paid.
  autoSendAgreedAt       DateTime?
  autoSendStatement      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  SetItem[]
  orders Order[]

  @@index([active, nextFireAt])
}

model SetItem {
  id    String @id @default(cuid())
  setId String
  set   Set    @relation(fields: [setId], references: [id], onDelete: Cascade)

  catalogueItemId String?
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)

  name                String
  quantity            Int    @default(1)
  estimatedPricePence Int

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Authentication — phone plus a one time code
// ---------------------------------------------------------------------------

/// A one time code, stored as a hash. The code itself is never written down.
model OneTimeCode {
  id         String      @id @default(cuid())
  phone      String
  codeHash   String
  role       AccountRole @default(shopper)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int         @default(0)
  /// When someone allowed to unlock cleared the limits for this number (ruling 81): a code
  /// with this set no longer counts towards how many may be sent.
  limitClearedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone, consumedAt])
}

/// Every time a person checked a Runner's documents, or took an approval back.
///
/// Only ever added to. The two flags on Runner are what job offers read; this is the record of
/// who set them, when, and on the strength of what, so the question "why was this person
/// allowed to deliver to somebody vulnerable" always has an answer. Copies of documents are
/// never kept here: only what kind of document was seen and a reference to it.
model RunnerCheck {
  id        String             @id @default(cuid())
  runnerId  String
  runner    Runner             @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  kind      RunnerCheckKind
  outcome   RunnerCheckOutcome
  /// What was seen, e.g. "Home Office share code checked on GOV.UK" or "Basic DBS certificate".
  evidence  String
  /// The name of the person who made the check.
  checkedBy String
  note      String             @default("")
  checkedAt DateTime           @default(now())

  @@index([runnerId])
}

/// A Runner telling the Shopper they cannot find something, and what the Shopper wants instead.
///
/// No phone numbers change hands: the question goes to the Shopper's screen, and the answer back
/// to the Runner's. If nobody answers within a few minutes the Shopper's own standing preference
/// decides, and where that was "ask me first" the item is left out — nothing is ever bought that
/// the Shopper did not agree to.
model ItemQuestion {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  askedAt     DateTime    @default(now())
  answer      ItemAnswer?
  /// `shopper` when they answered, `preference` when nobody did and their preference decided.
  answeredBy  String?
  answeredAt  DateTime?

  @@index([orderId])
}

/// A device a Shopper has allowed to show notifications. The browser's push address and the
/// keys for encrypting what is sent to it; no message is ever stored.
model PushSubscription {
  id        String   @id @default(cuid())
  shopperId String?
  shopper   Shopper? @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  /// The staff account that allowed notifications here: the owner letting Ozi ring him in the
  /// app (ruling 79). One device can be both a Shopper's and a staff member's.
  staffId   String?
  /// The Runner who allowed them, for a job the office sends (ruling 80).
  runnerId  String?
  runner    Runner?  @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([shopperId])
  @@index([staffId])
  @@index([runnerId])
}

/// An address a Shopper has saved for orders sent somewhere other than home: a child at
/// university, a friend across town, a customer. Unlimited. Saving one needs the PIN; a voice
/// order never uses one, only the home address.
model SavedAddress {
  id        String   @id @default(cuid())
  shopperId String
  shopper   Shopper  @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  /// What the Shopper calls it: "Tom's halls", "Mum".
  label     String   @default("")
  address   String
  createdAt DateTime @default(now())

  @@index([shopperId])
}

/// An in-app call about an order (docs/BUILD_PROMPT.md, Section F), carried by LiveKit. No
/// telephone number is stored anywhere in it.
model Call {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopperId        String
  runnerId         String
  /// The LiveKit room: unguessable, one per call.
  roomName         String    @unique
  /// "shopper" or "runner".
  startedBy        String
  /// "ringing", "live" or "ended".
  status           String    @default("ringing")
  createdAt        DateTime  @default(now())
  endedAt          DateTime?
  /// What the Shopper said yes to (Rule One).
  priceStatement   String?
  priceAcceptedAt  DateTime?
  pencePerMinute   Int
  billedMinutes    Int       @default(0)
  chargePence      Int       @default(0)
  /// "pending", "not_due", "paid" or "outstanding".
  chargeStatus     String    @default("pending")
  paymentReference String?
  chargedAt        DateTime?
  legs             CallLeg[]

  @@index([orderId])
  @@index([shopperId, chargeStatus])
}

/// One person's part in a call.
model CallLeg {
  id               String    @id @default(cuid())
  callId           String
  call             Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  /// "shopper", "runner" or "guest".
  role             String
  identity         String
  name             String
  connectedSince   DateTime?
  secondsConnected Int       @default(0)
  inviteCodeHash   String?   @unique
  priceStatement   String?
  createdAt        DateTime  @default(now())

  @@unique([callId, identity])
}

/// A document a Runner sent in. The photograph is removed once a person has decided, except the
/// face photograph, which is shown to the Shopper at the door.
model RunnerDocument {
  id          String    @id @default(cuid())
  runnerId    String
  runner      Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  /// face_photo, right_to_work, dbs, driving_licence_front, driving_licence_back, insurance.
  kind        String
  image       Bytes?
  contentType String?
  shareCode   String?
  expiresOn   DateTime?
  /// submitted, accepted or rejected.
  status      String    @default("submitted")
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// The automatic check (ruling 74): when it read it, whether every check was clearly fine,
  /// why not when it was not, and the name it read on the document.
  checkedAt   DateTime?
  checkPassed Boolean?
  checkNote   String?
  checkName   String?

  @@index([runnerId])
  @@index([status])
}

/// Something a Runner told us. No Runner is recorded when they chose to be anonymous.
model RunnerFeedback {
  id        String   @id @default(cuid())
  runnerId  String?
  message   String
  createdAt DateTime @default(now())
}

/// Something that went wrong with an order, with evidence, decided by a person.
model ProblemReport {
  id                   String            @id @default(cuid())
  orderId              String
  /// "runner" or "shopper".
  reportedBy           String
  reporterId           String
  summary              String
  refundRequestedPence Int               @default(0)
  /// "open" or "decided".
  status               String            @default("open")
  decideBy             DateTime
  /// shopper_at_fault, runner_at_fault, platform_at_fault, shop_at_fault or no_fault.
  decision             String?
  refundPence          Int               @default(0)
  refundReference      String?
  decisionNote         String?
  decidedBy            String?
  decidedAt            DateTime?
  createdAt            DateTime          @default(now())
  evidence             ProblemEvidence[]

  @@index([status, decideBy])
  @@index([orderId])
}

/// A voice note, photo or written note sent as evidence.
model ProblemEvidence {
  id          String        @id @default(cuid())
  reportId    String
  report      ProblemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  addedBy     String
  /// voice_note, photo or note.
  kind        String
  data        Bytes?
  contentType String?
  text        String?
  createdAt   DateTime      @default(now())

  @@index([reportId])
}

/// What a Runner owes after being found at fault, recovered a little from each job.
model RunnerRecovery {
  id             String    @id @default(cuid())
  runnerId       String
  reportId       String
  amountPence    Int
  recoveredPence Int       @default(0)
  writtenOff     Boolean   @default(false)
  /// Who wrote it off when the Runner left, and when (at or below problems.writeOffUpToPence).
  writtenOffBy   String?
  writtenOffAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([runnerId])
}

/// Ozi Finds It (7 October 2026): something hard to find, looked for by a person in up to three
/// shops, for a small finder fee agreed first. Given back if it cannot be found.
model FindRequest {
  id              String    @id @default(cuid())
  shopperId       String
  description     String
  feePence        Int
  /// The payment the fee was taken by; null when Ozi Plus covered it.
  chargeId        String?
  status          String    @default("looking")
  foundName       String?
  foundShop       String?
  foundPricePence Int?
  catalogueItemId String?
  refundId        String?
  note            String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([shopperId])
  @@index([status])
}

/// A gift card (7 October 2026): bought with a card, given as a code, kept as credit.
model GiftCard {
  id                  String    @id @default(cuid())
  code                String    @unique
  amountPence         Int
  buyerShopperId      String
  chargeId            String
  recipientName       String    @default("")
  message             String    @default("")
  redeemedByShopperId String?
  redeemedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([buyerShopperId])
}

/// An organisation asking to work with us (7 October 2026). A person rings them back.
model OrganisationEnquiry {
  id           String   @id @default(cuid())
  organisation String
  contactName  String
  telephone    String
  email        String   @default("")
  people       String   @default("")
  message      String   @default("")
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())

  /// organisation, or shop for a shop asking from /organisations?shop=1 (30 October 2026).
  kind          String    @default("organisation")
  /// When an organisation agreed to the Organisation terms at /organisation/terms, and which
  /// version.
  termsAgreedAt DateTime?
  termsVersion  String?
  /// The referral link the person asking came by, as kind:code (Anthony, 30 October 2026). Kept
  /// until staff set the organisation up, which records who referred it.
  joinedVia     String?
}

/// Somebody who runs the service, with their own admin sign-in (7 October 2026). What they can
/// see follows their role (packages/api/src/lib/staff.ts).
model StaffMember {
  id                 String    @id @default(cuid())
  name               String
  username           String    @unique
  /// scrypt, salted. Never the password.
  passwordHash       String
  role               String
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastSignInAt       DateTime?
  /// The founder's own account: the only one that sees the money.
  isOwner            Boolean   @default(false)
  /// The owner's 7-character passcode (6 digits and a special character), hashed.
  passcodeHash       String?
  /// Two-step codes from an authenticator app, if the owner turns them on.
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  /// For family and investor accounts: the parts the owner has switched on, comma separated.
  allowedAreas       String    @default("")
  /// Raised to sign every session of this account out at once.
  sessionVersion     Int       @default(0)
  /// Raised by "Sign out of this phone" (ruling 84): every remembered phone of this account is
  /// signed out; sessions on other devices are not.
  rememberedVersion  Int       @default(0)
  /// Two-step recovery codes, each hashed, comma separated. One is used up each time.
  recoveryCodes      String    @default("")
  /// May issue message and call codes, and message and call without one (ruling 77).
  canAuthorise       Boolean   @default(false)
  /// May send orders straight to a chosen Runner, outside the queue (ruling 80). The owner's to
  /// give, in Team; the owner always may.
  canAllocate        Boolean   @default(false)
  /// May unlock anybody locked out, and reset a Shopper's PIN or a staff member's password
  /// (ruling 81). The owner's to give, in Team; the owner always may.
  canUnlock          Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

/// A local shop on the monthly partner plan (7 October 2026): its own sign-in, its own
/// products, approved by us before Shoppers see them.
model PartnerShop {
  id             String    @id @default(cuid())
  name           String
  address        String    @default("")
  telephone      String    @default("")
  about          String    @default("")
  monthlyPence   Int
  /// The plan is paid up to here. Products show only while it is.
  paidUntil      DateTime?
  active         Boolean   @default(true)
  /// Ozi mentions, an extra on top of the plan: none, spotlight or plus.
  spotlight      String    @default("none")
  spotlightUntil DateTime?
  createdAt      DateTime  @default(now())
  /// Ruling 65: shop, food (a café or takeaway) or service.
  kind           String    @default("shop")
  /// pending until a person approves the page, approved, or removed. Paused is `active` false.
  status         String    @default("approved")
  /// free (a basic listing) or plus (Partner Plus, while paidUntil is ahead).
  plan           String    @default("plus")
  /// One of the first free-for-ever listings.
  freeForever    Boolean   @default(false)
  /// The free first month of Partner Plus has been taken.
  plusTrialUsed  Boolean   @default(false)
  /// When the shop agreed to the Shop Partner terms at /partner/terms, and which version.
  termsAgreedAt  DateTime?
  termsVersion   String?
  /// self (joined through the app), staff (added from a paper form), ozi (listed by Ozi) or claimed.
  source         String    @default("staff")
  /// The seed entry this shop came from, so the seed never adds it twice.
  seedKey        String?   @unique
  postcode       String    @default("")
  hours          String    @default("")
  contactName    String    @default("")
  /// Private: for sign-in codes and for us to ring. Never shown.
  mobile         String    @default("")
  email          String    @default("")
  approvedAt     DateTime?
  /// Ruling 82: a restaurant's cuisines, from browse.cuisines in config/store.json.
  cuisines       String[]  @default([])
  /// Ruling 82: a shop's specialities, from browse.shopOrigins.
  specialities   String[]  @default([])
  /// Ruling 82: a service's categories, from browse.serviceCategories.
  categories     String[]  @default([])
  /// Ruling 82: a corner shop, convenience store or mini-market.
  convenience    Boolean   @default(false)
  /// Ruling 82: a childminder's Ofsted registration number, as they gave it. Never checked by us.
  ofstedNumber   String    @default("")
  /// The Ozi Ambassador who introduced it (Anthony, 30 October 2026): shopper, runner, partner
  /// or organisation, and that account's id. Never the shop's own owner.
  ambassadorKind String?
  ambassadorId   String?
  /// Another listing of the same business, marked by staff: each branch is its own venture.
  branchOfShopId String?
  /// A restaurant's agreed discount for Ozi, a whole percentage (Anthony, 30 October 2026): it
  /// sells to Ozi at its shop price less this. 0 for none, and for every shop and service. At
  /// restaurants.preferredDiscountPercent or more it is an Ozi Preferred Partner.
  agreedDiscountPercent Int @default(0)
  /// An agreed mark-up on the partner's prices, a whole percentage (Anthony, 30 October 2026):
  /// Shoppers see and pay the shop price with this on it. 0 for none; never for a service.
  agreedMarkupPercent   Int @default(0)
  /// Signed up by an Ozi Ambassador with the owner present (Anthony, 30 October 2026): the
  /// reference on the printed Shop Partner agreement sheet, checked by staff when they approve;
  /// the mark-up and discount agreed, proposed until staff confirm them; and the name the owner
  /// typed when they agreed to the Shop Partner terms.
  agreementReference      String? @unique
  proposedMarkupPercent   Int?
  proposedDiscountPercent Int?
  ownerAgreedName         String?
  /// Protections against Ambassadors misusing the name (Anthony, 31 October 2026). A business an
  /// Ambassador signed up must confirm with a code sent to its own phone, on its own device, before
  /// the Ambassador earns anything from it (ambassadorConfirmNeeded); ambassadorConfirmedAt is when
  /// the Ambassador's introduction was confirmed, the first confirmed claim winning.
  ambassadorConfirmNeeded Boolean   @default(false)
  ambassadorConfirmedAt   DateTime?
  /// "Were you promised anything that isn't in your agreement?", asked once about a week after a
  /// business joins through an Ambassador: when the text went, and the answer (yes or no) and note.
  promiseTextSentAt       DateTime?
  promiseAnswer           String?
  promiseNote             String?
  promiseAnsweredAt       DateTime?
  /// The welcome text with the payment warning, sent once to the business's own number.
  welcomeTextSentAt       DateTime?

  @@index([ambassadorKind, ambassadorId])
}

/// A Shopper asking a service for a quote or a call back (ruling 65). No money moves.
model ServiceEnquiry {
  id            String    @id @default(cuid())
  partnerShopId String
  shopperId     String
  productId     String?
  kind          String
  message       String    @default("")
  /// How the Shopper chose to be reached, in their own words. Shown to the service only.
  contact       String    @default("")
  status        String    @default("open")
  reply         String?
  createdAt     DateTime  @default(now())
  answeredAt    DateTime?

  @@index([partnerShopId])
  @@index([shopperId])
}

/// A product a partner shop sent in. Shoppers see it once a person has approved it.
model PartnerProduct {
  id              String    @id @default(cuid())
  partnerShopId   String
  name            String
  pricePence      Int
  tags            String    @default("")
  expiresOn       DateTime?
  photo           Bytes?
  photoType       String?
  status          String    @default("pending")
  note            String?
  catalogueItemId String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  /// A service: how long it takes, in minutes. Its price is "from".
  durationMinutes Int?
  /// The barcode, when the shop scanned one (ruling 75): one listing for every identical pack.
  barcode         String?
  /// The price was not on the label, so it is an estimate the shop and the owner should check.
  priceEstimated  Boolean   @default(false)
  /// The automatic check (ruling 74): when it last looked, and what it found when unsure.
  checkedAt       DateTime?
  checkNote       String?

  @@index([partnerShopId])
  @@index([status])
}

/// Somebody signing in for a partner shop or an organisation, each with their own password.
model BusinessUser {
  id                 String    @id @default(cuid())
  kind               String
  partnerShopId      String?
  organisationId     String?
  name               String
  office             String    @default("")
  username           String    @unique
  passwordHash       String
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastSignInAt       DateTime?
  createdAt          DateTime  @default(now())
}

/// What a Shop Partner has paid us: the plan, Spotlight or Spotlight Plus, a month at a time.
model PartnerPayment {
  id            String   @id @default(cuid())
  partnerShopId String
  kind          String
  amountPence   Int
  months        Int
  coversUntil   DateTime
  recordedBy    String
  paidAt        DateTime @default(now())
  /// The Stripe Checkout session that paid it, so a payment is recorded once only.
  reference     String?  @unique

  @@index([partnerShopId])
}

/// Each time Ozi mentions a Spotlight shop to a Shopper, for the weekly limit and the shop's report.
model SpotlightMention {
  id            String   @id @default(cuid())
  partnerShopId String
  /// A one-way code for the Shopper, never their name or number.
  shopperKey    String
  query         String
  at            DateTime @default(now())

  @@index([shopperKey, at])
  @@index([partnerShopId, at])
}

/// Business analysis (7 October 2026): what happened, when and where, with no names, numbers or
/// addresses. People appear only as one-way codes; places only as postcode districts.
model AnalyticsEvent {
  id              String   @id @default(cuid())
  at              DateTime @default(now())
  kind            String
  shopperKey      String?
  runnerKey       String?
  shop            String?
  /// The Shop Partner's id, from 30 October 2026; older rows have only the shop's name.
  partnerShopId   String?
  area            String?
  toArea          String?
  ageBand         String?
  viaOrganisation Boolean  @default(false)
  itemCount       Int      @default(0)
  goodsPence      Int      @default(0)
  categories      String   @default("")
  query           String?
  travelMode      String?
  /// Checkout insights (Anthony, 30 October 2026): on checkout_viewed and checkout_paid rows, the
  /// breakdown the Shopper was shown (goodsPence above, then these), whether it was a restaurant
  /// order, whether the no-Runner warning was shown, a returning Shopper or a new one, and how
  /// they ordered (web, voice or phone). On a checkout_reason row, the answer they tapped. Never
  /// a card detail.
  itemChargesPence Int?
  feePence         Int?
  totalPence       Int?
  restaurant       Boolean?
  noRunnerWarning  Boolean?
  returning        Boolean?
  channel          String?
  answer           String?

  @@index([at])
  @@index([kind, at])
  @@index([shop, at])
}

/// Money in and out (7 October 2026): every payment taken and every refund given, by gateway.
/// Seen only by the owner.
model IncomeRecord {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  gateway     String
  kind        String
  amountPence Int
  reference   String

  @@index([at])
}

/// What Ozi was asked and could not answer, for a person to approve an answer (ruling 49).
/// Never anything with a banned word or anything that looks personal; who said it is not kept.
model LearnedPhrase {
  id           String    @id @default(cuid())
  account      String
  text         String
  timesHeard   Int       @default(1)
  firstHeardAt DateTime
  lastHeardAt  DateTime
  status       String    @default("waiting")
  reply        String?
  decidedBy    String?
  decidedAt    DateTime?
  /// Ozi's own weekly review (31 October 2026): a better answer it suggests, for a person to
  /// approve or change. Never used until a person approves it.
  suggestedReply String?
  suggestedAt    DateTime?

  @@unique([account, text])
  @@index([status, timesHeard])
}

/// Ozi's memory (17 October 2026, ruling 68): every exchange on every channel, what was heard and
/// what was said, with the verdicts people give it. Numbers, emails, postcodes and codes are
/// blanked before a row is written; the conversation is a one-way code, never a number.
model OziExchange {
  id              String    @id @default(cuid())
  at              DateTime  @default(now())
  channel         String
  account         String
  conversationKey String
  turn            Int       @default(0)
  heard           String
  said            String
  brain           String
  outcome         String
  verdict         String    @default("unrated")
  betterReply     String?
  ratedBy         String?
  ratedAt         DateTime?
  /// The exact model that answered, when brain is "model" (31 October 2026).
  model           String?
  /// Who was speaking: shopper, runner, partner, organisation, staff, owner or visitor.
  accountKind     String?
  /// When Ozi's weekly self-review looked at this exchange, so it is never looked at twice.
  reviewedAt      DateTime?

  @@index([at])
  @@index([verdict, at])
  @@index([channel, at])
  @@index([conversationKey, at])
}

/// A Runner pressing SOS (Section M): where they are, kept up to date while it is on, and a
/// private link for the owner that stops working. Never anything about the Shopper's phone.
model RunnerSos {
  id             String    @id @default(cuid())
  runnerId       String
  runner         Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  /// The job they were on, if any.
  orderId        String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  endedBy        String?
  latitude       Float?
  longitude      Float?
  accuracyMetres Float?
  locationAt     DateTime?
  /// The hash of the code in the private link. Never the code itself.
  linkCodeHash   String    @unique
  linkExpiresAt  DateTime
  alertSentAt    DateTime?
  alertProblem   String?

  @@index([runnerId, endedAt])
}

/// The private referral reward (rulings 12 and 16), given by the owner. Not announced.
model ReferralReward {
  id              String   @id @default(cuid())
  /// Whose share link: shopper:<handle> or runner:<Runner ID>.
  referrer        String
  qualifyingCount Int
  amountPence     Int
  /// credit (a Shopper's credit), transfer (a Runner's own Stripe account) or by_hand.
  method          String
  reference       String?
  decidedBy       String
  createdAt       DateTime @default(now())

  @@index([referrer])
}

/// Who brought whom (Anthony, 30 October 2026): every account opened through somebody's referral
/// link, of any kind by any kind. One row per new account. Whether it is active is worked out
/// from what the account has done, never stored.
model Referral {
  id           String   @id @default(cuid())
  /// shopper, runner, partner or organisation.
  referrerKind String
  referrerId   String
  /// shopper, runner, partner or organisation.
  joinedKind   String
  joinedId     String
  /// The link as followed, kind:code, for example shopper:margaret.
  via          String
  createdAt    DateTime @default(now())

  @@unique([joinedKind, joinedId])
  @@index([referrerKind, referrerId])
}

/// A referral reward level somebody reached (Anthony, 30 October 2026), kept once reached. The
/// owner is told once; the person is told on their dashboard and by Ozi once; staff give the
/// voucher by hand and mark it given.
/// A referral reward voucher staff sent to the person who reached the level (Anthony, 30
/// October 2026). The code is sensitive: shown in full only to the person and to staff who open
/// the record, never written in an application log, and emptied when the account is erased.
model ReferralVoucher {
  id             String    @id @default(cuid())
  /// The level reached it is for: one voucher a level.
  levelId        String    @unique
  accountKind    String
  accountId      String
  label          String
  rewardPence    Int
  code           String
  link           String?
  /// The message in the person's inbox it went in.
  messageId      String?
  sentById       String?
  sentByName     String
  sentAt         DateTime
  /// The first time the person opened or read the message.
  openedAt       DateTime?
  /// When the person tapped "I've used it" (their word: Amazon cannot tell us).
  usedAt         DateTime?
  /// Ozi's reminder calls: at most three, stopping once it is opened.
  nextReminderAt DateTime?
  ringingUntil   DateTime?
  reminder1At    DateTime?
  reminder1Via   String?
  reminder2At    DateTime?
  reminder2Via   String?
  reminder3At    DateTime?
  reminder3Via   String?
  erasedAt       DateTime?

  @@index([accountKind, accountId])
  @@index([nextReminderAt])
}

model ReferralLevelReached {
  id              String    @id @default(cuid())
  referrerKind    String
  referrerId      String
  /// The level: so many active referrals.
  activeReferrals Int
  rewardPence     Int
  label           String
  /// How many were active, and had joined, when it was reached.
  activeAtReach   Int
  joinedAtReach   Int
  reachedAt       DateTime  @default(now())
  /// When Ozi told the person in the app.
  toldAt          DateTime?
  givenAt         DateTime?
  givenBy         String?

  @@unique([referrerKind, referrerId, activeReferrals])
  @@index([reachedAt])
}

/// Somebody who chose to become an Ozi Ambassador (Anthony, 30 October 2026), with when they
/// agreed to the Ambassador terms at /ambassador/terms and which version. Only then do they have
/// an Ambassador link.
model AmbassadorAgreement {
  id                       String    @id @default(cuid())
  /// shopper, runner, partner or organisation.
  accountKind              String
  accountId                String
  agreedAt                 DateTime  @default(now())
  termsVersion             String
  /// Their own Stripe account for withdrawals (ruled 30 October 2026). Stripe collects the bank
  /// details on its own form; they never pass through the service.
  stripeConnectedAccountId String?
  /// Flagged by staff: every withdrawal waits for a person to approve it.
  flaggedAt                DateTime?
  flagReason               String?
  /// The application (Anthony, 30 October 2026): applied, documents_sent, documents_checked,
  /// chat_done, approved, declined or suspended. Those who agreed before applications began are
  /// documents_needed: their link and earnings carry on, the Toolkit and withdrawals wait.
  status                   String    @default("applied")
  /// passport, driving_licence or residence_card.
  idType                   String?
  documentsSentAt          DateTime?
  documentsCheckedAt       DateTime?
  /// The short chat with the founder, recorded by staff, with their notes.
  chatDoneAt               DateTime?
  chatDoneBy               String?
  chatNotes                String    @default("")
  /// Approved, declined or suspended: when, by whom, and the reason the person sees.
  decidedAt                DateTime?
  decidedBy                String?
  decisionReason           String?
  approvedAt               DateTime?
  /// When they stopped being an Ambassador, or were declined: their documents are removed 12
  /// months after.
  stoppedAt                DateTime?
  /// The separate yes or no to comparing their face photo with the photo on their ID (Anthony,
  /// 31 October 2026), and when they answered. Null until they answer; no means a person checks.
  faceCompareConsent       Boolean?
  faceCompareConsentAt     DateTime?
  /// The status they had when suspended, to go back to if the suspension is lifted.
  suspendedFrom            String?
  /// When the files of a declined or removed Ambassador were removed by the retention sweep.
  documentsRemovedAt       DateTime?
  /// Their code on the public "Check an Ambassador" page and on every printed QR code (31 October
  /// 2026): six letters and numbers, made when they are approved. Never their name or number.
  checkCode                String?   @unique

  documents AmbassadorDocument[]

  @@unique([accountKind, accountId])
  @@index([status])
}

/// A document sent with an Ambassador application (Anthony, 30 October 2026): a photo ID, the back
/// of a card, a proof of address, a face photo, or a Home Office share code. Read by the automatic
/// check like a Runner's; kept while they are an Ambassador and for 12 months after they stop.
model AmbassadorDocument {
  id            String              @id @default(cuid())
  agreementId   String
  agreement     AmbassadorAgreement @relation(fields: [agreementId], references: [id])
  accountKind   String
  accountId     String
  /// photo_id_front, photo_id_back, proof_of_address, face_photo or share_code.
  kind          String
  /// passport, driving_licence or residence_card, for a photo ID.
  idType        String?
  /// utility_bill, bank_letter or council_tax, for a proof of address.
  addressType   String?
  image         Bytes?
  contentType   String?
  shareCode     String?
  /// submitted, accepted or rejected.
  status        String              @default("submitted")
  checkedAt     DateTime?
  checkPassed   Boolean?
  checkNote     String?
  checkName     String?
  /// The date on a proof of address, as read, YYYY-MM-DD.
  checkIssuedOn String?
  reviewNote    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  erasedAt      DateTime?

  @@index([agreementId])
  @@index([accountKind, accountId])
  @@index([status])
}

/// A short note kept after an Ambassador application is declined, or an Ambassador removed for
/// fraud (Anthony, 31 October 2026): the name, the name on their ID, the date of birth if held,
/// the date and the reason. Used only to enforce the wait before applying again, to bar somebody
/// removed for fraud, and to spot an application under a false identity. A declined note is
/// removed after `ambassador.declinedNoteKeptMonths` (deleteAfter); a fraud bar stays (null).
model AmbassadorNote {
  id          String    @id @default(cuid())
  agreementId String?
  accountKind String
  accountId   String
  /// declined or fraud.
  kind        String
  name        String
  nameOnId    String?
  /// YYYY-MM-DD, only if staff had it.
  dateOfBirth String?
  reason      String
  at          DateTime  @default(now())
  deleteAfter DateTime?

  @@index([accountKind, accountId])
  @@index([deleteAfter])
}

/// What an Ozi Ambassador has earned and been paid (Anthony, 30 October 2026): a share of an
/// order's profit, the Partner Plus bonus, a deduction for a refund that came after a share was
/// available, or a payment. A pending share follows its order's final state (ruled the same day);
/// nothing is ever removed.
model AmbassadorEntry {
  id             String    @id @default(cuid())
  ambassadorKind String
  ambassadorId   String
  /// share (of an order's profit), bonus (of the first Partner Plus payment), deduction or
  /// payment.
  kind           String
  /// The business it was earned from; null for a payment.
  partnerShopId  String?
  orderId        String?
  /// What the share was worked from: Ozi's profit on the order (item charges, or a café's
  /// commission), or the first Partner Plus payment.
  profitPence    Int       @default(0)
  /// Earned, taken off, or paid: always zero or more.
  amountPence    Int
  /// When a share or bonus stops being pending (30 days after delivery) and can be paid.
  availableAt    DateTime?
  /// A card chargeback on its order: the share is worth nothing.
  disputedAt     DateTime?
  /// Makes each one once only: share:<order>:<shop>, bonus:<shop>, deduction:<entry>,
  /// payment:<time> or withdrawal:<id>.
  reference      String    @unique
  recordedBy     String?
  at             DateTime  @default(now())
  /// Removed for fraud (Anthony, 31 October 2026): the unpaid part cancelled, how much, and why.
  /// What is left is in amountPence.
  cancelledAt    DateTime?
  cancelledPence Int       @default(0)
  cancelReason   String?
  /// Held for a person to check (Anthony, 31 October 2026): the order's Shopper matched the
  /// Ambassador or the business owner (card, phone, device or delivery address). A held share
  /// counts for nothing until staff release it.
  heldAt         DateTime?
  heldReason     String?

  @@index([ambassadorKind, ambassadorId])
  @@index([partnerShopId])
  @@index([orderId])
}

/// A device an account was seen using (Anthony, 31 October 2026): a random id the app makes and
/// keeps on the device, never anything read from it. Used only to see when an order that would
/// earn an Ambassador a share came from the Ambassador's own device, or the business owner's.
model DeviceSighting {
  id          String   @id @default(cuid())
  deviceId    String
  /// shopper, runner or partner.
  accountKind String
  accountId   String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([deviceId, accountKind, accountId])
  @@index([accountKind, accountId])
}

/// An Ambassador's claim to have brought a business in (Anthony, 31 October 2026): waiting for the
/// business to confirm with the code sent to its own phone, confirmed, or refused (another
/// Ambassador's confirmed claim came first, or the business said no). Only a keyed hash of the code
/// is kept. The first confirmed claim wins.
model AmbassadorClaim {
  id             String    @id @default(cuid())
  partnerShopId  String
  ambassadorKind String
  ambassadorId   String
  /// waiting, confirmed or refused.
  status         String    @default("waiting")
  codeHash       String?
  codeExpiresAt  DateTime?
  codeSentAt     DateTime?
  attempts       Int       @default(0)
  refusedReason  String?
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?

  @@index([partnerShopId])
  @@index([ambassadorKind, ambassadorId])
}

/// An Ambassador asking for their available money to go to their bank (ruled 30 October 2026):
/// sent by a Stripe transfer to their own Stripe account, or waiting for staff to approve it when
/// it is over the monthly review figure or they are flagged.
model AmbassadorWithdrawal {
  id               String    @id @default(cuid())
  ambassadorKind   String
  ambassadorId     String
  amountPence      Int
  /// waiting_approval, sent, refused or failed.
  status           String
  waitingReason    String?
  requestedAt      DateTime  @default(now())
  decidedAt        DateTime?
  decidedBy        String?
  stripeTransferId String?
  failure          String?

  @@index([ambassadorKind, ambassadorId])
  @@index([status])
}

/// Who did what in the admin panel, and when (Section Q). Only ever added to: the server has
/// no way to change or remove an entry, and the database refuses to (see the migration).
model AuditEntry {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  /// The staff account, or null for the staff key.
  actorId   String?
  actorName String
  actorRole String
  /// What was done, such as "POST /staff/problems/:id/decide" or "shopper.opened".
  action    String
  /// What it was done to, such as an order or a Shopper.
  target    String   @default("")
  /// A short record of what was sent, with every password, passcode and code taken out.
  detail    String   @default("")
  /// The internet address it came from.
  ip        String   @default("")

  @@index([at])
  @@index([actorId])
}

/// Every time a Runner's spending card was used: each authorization the shop asked for, approved
/// or declined and why, and each transaction that followed (amount spent, positive; a refund,
/// negative). Keyed by Stripe's own identifier, so a repeated webhook changes nothing.
model CardAuthorization {
  id          String   @id @default(cuid())
  stripeId    String   @unique
  /// "authorization" or "transaction".
  kind        String
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  runnerId    String?
  runner      Runner?  @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  amountPence Int
  approved    Boolean
  /// Why it was approved or declined, in plain words.
  reason      String   @default("")
  /// Stripe's status for an authorization: pending, closed or reversed.
  status      String   @default("")
  merchant    String   @default("")
  at          DateTime @default(now())

  @@index([orderId])
  @@index([runnerId, at])
}

/// A Shopper's review of a Shop Partner after a delivered order that had its things in it
/// (ruling 70). One per order per shop; one rewarded review per shop per month per Shopper.
/// The points wait seven days (`pending`), then are `earned`, or `void` if the order was
/// refunded. Never shown with a name: shops and the public see counts and averages only.
model ShopReview {
  id            String    @id @default(cuid())
  orderId       String
  shopperId     String
  partnerShopId String
  /// 1 to 5.
  stars         Int
  message       String    @default("")
  /// The points this review earns, the same for one star as for five.
  points        Int       @default(0)
  /// pending, earned or void.
  status        String    @default("pending")
  earnedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@unique([orderId, partnerShopId])
  @@index([shopperId, createdAt])
  @@index([partnerShopId, createdAt])
  @@index([status, createdAt])
}

/// Review points turned into delivery credit (ruling 70): once a Shopper has enough, whole
/// hundreds become pence on their account, and this is the record of each conversion. The
/// balance is what was earned less what is here.
model ReviewPointsSpend {
  id        String   @id @default(cuid())
  shopperId String
  points    Int
  pence     Int
  createdAt DateTime @default(now())

  @@index([shopperId])
}

/// Ozi's desk (ruling 74): something that needs the owner. Ozi rings him about it and he decides
/// with the keypad, or in the admin panel. The summary is said aloud: never a card number, never
/// a customer's telephone number.
model OwnerMatter {
  id           String    @id @default(cuid())
  /// sos, runner_document, runner_application, partner_product, partner_shop,
  /// organisation_enquiry, problem, shopper_feedback, pay_back, till_case, bank_transfer,
  /// waiting_order or find_it.
  kind         String
  subjectId    String
  summary      String
  /// decide (approve, decline or later) or acknowledge (heard, or later).
  options      String
  urgent       Boolean   @default(false)
  /// open, later, decided or handled.
  status       String    @default("open")
  /// approve, decline, acknowledge or settled.
  decision     String?
  /// phone, panel or automatic.
  decidedVia   String?
  decidedBy    String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
  laterUntil   DateTime?
  callAttempts Int       @default(0)
  lastCalledAt DateTime?
  lastReadAt   DateTime?
  /// For an email (ruling 76): who it is from and its subject, for the admin panel.
  emailFrom    String?
  emailSubject String?
  /// Which of the owner's alert choices it follows (ruling 85): urgentSafety, importantEmail,
  /// otherEmail, approvals or money; null to follow its kind.
  alertKind    String?
  /// When a text or notification about it went to the owner, by his alert choices (ruling 85).
  alertedAt    DateTime?

  @@index([status, createdAt])
  @@index([kind, subjectId])
}

/// Each call Ozi placed to the owner about his matters (ruling 74), so the escalation (three in
/// a row, then an hour, then three again) survives a restart.
model OwnerCall {
  id            String    @id @default(cuid())
  cascade       Int
  attempt       Int
  placedAt      DateTime
  /// app_ringing, placed, answered, unanswered, voicemail or failed.
  status        String    @default("placed")
  answeredAt    DateTime?
  endedAt       DateTime?
  matterCount   Int       @default(0)
  /// Ringing in the app first until then (ruling 79); null when it went straight to the phone.
  appRingUntil  DateTime?
  /// When the phone was rung for this attempt.
  phonePlacedAt DateTime?
  /// app or phone.
  answeredVia   String?
  /// A test call from My settings, never counted in the rounds of calls.
  test          Boolean   @default(false)

  @@index([placedAt])
}

/// Each email read from the business mailbox (ruling 76), so none is read twice. Only the
/// sender's domain is kept: never the address, the subject or the words.
model EmailMessage {
  id          String   @id @default(cuid())
  messageId   String   @unique
  fromDomain  String
  /// important_decision, complaint, partner_or_organisation, runner, customer_question,
  /// invoice_or_bill, legal_or_official, spam_or_marketing, newsletter,
  /// automated_notification or other.
  category    String
  important   Boolean  @default(false)
  matterId    String?
  replied     Boolean  @default(false)
  processedAt DateTime @default(now())

  @@index([processedAt])
}

/// The company inbox (ruling 77): one conversation between the company and one account, a
/// Shopper, a Runner, a partner shop or an organisation. Never one account to another.
model InboxThread {
  id            String         @id @default(cuid())
  /// shopper, runner, partner or organisation.
  accountKind   String
  accountId     String
  createdAt     DateTime       @default(now())
  lastMessageAt DateTime       @default(now())
  messages      InboxMessage[]

  @@unique([accountKind, accountId])
  @@index([lastMessageAt])
}

/// One message, from a staff member (with what authorised it) or from the account.
model InboxMessage {
  id               String      @id @default(cuid())
  threadId         String
  thread           InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromStaff        Boolean
  staffId          String?
  senderName       String
  text             String
  createdAt        DateTime    @default(now())
  sentAt           DateTime?
  readAt           DateTime?
  /// sent, held (waiting for the owner on Ozi's desk) or declined.
  status           String      @default("sent")
  /// self, code or desk.
  authorisedBy     String?
  authorisedByName String?

  @@index([threadId, createdAt])
  @@index([fromStaff, createdAt])
}

/// A message code or a daily call code issued to one staff member. Only the hash is kept.
model StaffContactCode {
  id           String    @id @default(cuid())
  /// message or call.
  kind         String
  staffId      String
  codeHash     String
  issuedById   String?
  issuedByName String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?

  @@index([staffId, kind])
}

/// A call from the company to an account (ruling 77), with its recording if there is one.
model StaffCall {
  id               String    @id @default(cuid())
  roomName         String    @unique
  staffId          String?
  staffName        String
  accountKind      String
  accountId        String
  accountName      String
  /// self, code or desk.
  authorisedBy     String
  authorisedByName String?
  /// ringing, live or ended.
  status           String    @default("ringing")
  startedAt        DateTime
  answeredAt       DateTime?
  endedAt          DateTime?
  durationSeconds  Int       @default(0)
  phoneRung        Boolean   @default(false)
  /// none, recording, saved, not_recorded, failed or deleted.
  recordingStatus  String    @default("none")
  recordingKey     String?
  egressId         String?
  recordingNote    String?

  @@index([startedAt])
  @@index([accountKind, accountId])
}

/// A postcode's place, looked up once with postcodes.io and kept (Anthony, 30 October 2026), so
/// nothing asks it on every request. `found` false: postcodes.io did not know it, or could not be
/// reached, and the place is unknown; it is asked again after a while.
model PostcodePlace {
  id         String   @id @default(cuid())
  postcode   String   @unique
  latitude   Float?
  longitude  Float?
  found      Boolean  @default(false)
  lookedUpAt DateTime @default(now())
}

/// An area's own record (Anthony, 30 October 2026): paused by staff, and when it first had an
/// approved Runner, which is when the Shoppers warned there was none were texted. Every area is
/// open; a paused one still takes orders. An area with no record is simply not paused.
model Area {
  id        String    @id @default(cuid())
  area      String    @unique
  pausedAt  DateTime?
  pausedBy  String?
  startedAt DateTime?
  updatedAt DateTime  @updatedAt
}

/// A Shopper warned, as they ordered, that their area had no Runner (driver) yet (Anthony, 30
/// October 2026), texted once when one joins there. Still called the waiting list. Goes with
/// their account when it is closed.
model AreaWaiting {
  id        String    @id @default(cuid())
  area      String
  shopperId String
  postcode  String    @default("")
  createdAt DateTime  @default(now())
  textedAt  DateTime?

  @@unique([area, shopperId])
  @@index([area, textedAt])
}

/// Who signed in to the admin panel, and roughly where (ruling 85, 31 October 2026): each sign-in
/// and each spell of activity. Never the internet address itself, only a keyed one-way code of
/// it; the place is only what the hosting platform's own header says (a town or a country), never
/// looked up anywhere. Kept `admin.staffSightingsKeepDays` (90), then swept away.
model StaffSighting {
  id            String   @id @default(cuid())
  staffId       String
  at            DateTime @default(now())
  /// sign_in or activity.
  event         String   @default("activity")
  /// A keyed one-way code of the internet address, so two sightings can be matched, no more.
  ipHash        String
  /// A town or a country, from the platform's header; null when nothing said.
  place         String?
  /// phone, tablet, computer or other.
  userAgentKind String   @default("other")

  @@index([staffId, at])
  @@index([at])
}

/// A short spoken summary of one email, for the owner to listen to (ruling 85): which mailbox,
/// who it is from (the display name only), the subject, when it came, one or two sentences, the
/// category, and whether it is important and whether he has heard it. The start of its plain
/// words is kept with phone numbers, card numbers, codes and email addresses blanked. Never an
/// attachment. The sender's address is kept only to send his reply, and is never shown or said.
/// Kept `emailDesk.summaryKeepDays` (30), then swept away.
model EmailSummary {
  id           String    @id @default(cuid())
  messageId    String    @unique
  /// 1 for the first mailbox (EMAIL_IMAP_*), 2 to 5 for EMAIL_2_* to EMAIL_5_*.
  mailbox      Int       @default(1)
  mailboxLabel String
  fromName     String?
  /// For his reply only. Never shown, never read aloud.
  replyTo      String    @default("")
  subject      String    @default("")
  receivedAt   DateTime
  summary      String
  category     String
  important    Boolean   @default(false)
  heard        Boolean   @default(false)
  heardAt      DateTime?
  /// The start of the plain words, blanked as above.
  excerpt      String    @default("")
  createdAt    DateTime  @default(now())

  @@index([receivedAt])
  @@index([heard, receivedAt])
}

/// The owner's own choices for how Ozi reaches him (ruling 85): one row, keyed "owner". Each kind
/// of matter is call, text, notification or none; urgent safety is always call. The quiet hours
/// are UK time, "HH:MM". Config/store.json's ownerAlerts and ownerDesk are the defaults.
model OwnerPreference {
  id             String   @id @default(cuid())
  key            String   @unique
  urgentSafety   String   @default("call")
  importantEmail String   @default("call")
  otherEmail     String   @default("none")
  approvals      String   @default("call")
  money          String   @default("call")
  quietFrom      String
  quietUntil     String
  updatedAt      DateTime @default(now())
  updatedBy      String   @default("")
}
