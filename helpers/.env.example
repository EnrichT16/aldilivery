# Copy to .env for a Node server or home computer, and fill in what you use.
# Never commit .env. On Cloudflare, set these with `npx wrangler secret put NAME` instead.

# Needed
ADMIN_TOKEN=                 # a long random password for the admin page
OWNER_PHONE=                 # for urgent alerts, for example +447700900000
OWNER_EMAIL=                 # for the briefing by email (optional)

# Incoming email by webhook (an email service posts to /hooks/email)
INBOX_WEBHOOK_SECRET=        # a long random password the email service sends with each email
INBOX_FORWARD_TO=            # Cloudflare only: a person's own inbox that also gets every email

# Incoming email by IMAP (Node server or home computer only; npm install imapflow)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=               # an app password, never the main password

# Sending replies (pick one in helpers.config.json "email")
RESEND_API_KEY=

# Texts (pick one in helpers.config.json "sms")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=

# Brains (only the one each helper uses)
CLOUDFLARE_ACCOUNT_ID=       # Workers AI from outside Cloudflare
CLOUDFLARE_API_TOKEN=
ANTHROPIC_API_KEY=           # Claude through the API (billed per use)
OLLAMA_URL=                  # if not http://localhost:11434

# Node server
PORT=8787
HOST=127.0.0.1               # 0.0.0.0 to listen beyond this computer (put it behind HTTPS)
HELPERS_DATA=data/helpers.json
